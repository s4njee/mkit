{
  "manifest_version": 1,
  "component": "disclosure",
  "source_spec_version": 1,
  "adapter_contract": {
    "fixture": "Provide each declared state fixture; load the initial_state fixture before dispatch.",
    "keyboard": "Dispatch the key with modifiers, then assert every field in the case's assert mapping.",
    "accessibility": "Capture the actual platform accessibility tree and compare declared semantics.",
    "screenshots": "Render each state/theme/scale case and compare its named baseline.",
    "custom_tests": null
  },
  "keyboard_cases": [
    {
      "id": "keyboard-01",
      "dispatch": {
        "key": "Enter",
        "modifiers": []
      },
      "precondition": "Disclosure trigger is focused and enabled.",
      "expected_behavior": "Toggle expanded state.",
      "initial_state": "collapsed",
      "load_fixture": "collapsed_fixture",
      "assert": {
        "event": "ExpandedChanged"
      }
    },
    {
      "id": "keyboard-02",
      "dispatch": {
        "key": "Space",
        "modifiers": []
      },
      "precondition": "Disclosure trigger is focused and enabled.",
      "expected_behavior": "Toggle expanded state.",
      "initial_state": "collapsed",
      "load_fixture": "collapsed_fixture",
      "assert": {
        "event": "ExpandedChanged"
      }
    }
  ],
  "accessibility_cases": [
    {
      "id": "a11y-collapsed",
      "state": "collapsed",
      "load_fixture": "collapsed_fixture",
      "expected_semantics": {
        "role": "button",
        "properties": [
          {
            "name": "expanded",
            "value": false
          },
          {
            "name": "panel",
            "value": "stable content id"
          }
        ]
      },
      "capture": "mkit_harness::AccessibilitySnapshot::capture",
      "requires_active_platform_a11y": true,
      "headless_inactive_result": "unsupported_pending"
    },
    {
      "id": "a11y-expanded",
      "state": "expanded",
      "load_fixture": "expanded_fixture",
      "expected_semantics": {
        "role": "button",
        "properties": [
          {
            "name": "panel",
            "value": "stable content id"
          }
        ]
      },
      "capture": "mkit_harness::AccessibilitySnapshot::capture",
      "requires_active_platform_a11y": true,
      "headless_inactive_result": "unsupported_pending"
    },
    {
      "id": "a11y-disabled",
      "state": "disabled",
      "load_fixture": "disabled_fixture",
      "expected_semantics": {
        "role": "button",
        "properties": [
          {
            "name": "panel",
            "value": "stable content id"
          },
          {
            "name": "disabled",
            "value": true
          }
        ]
      },
      "capture": "mkit_harness::AccessibilitySnapshot::capture",
      "requires_active_platform_a11y": true,
      "headless_inactive_result": "unsupported_pending"
    }
  ],
