{
  "manifest_version": 1,
  "component": "layer-panel",
  "source_spec_version": 1,
  "adapter_contract": {
    "fixture": "Provide each declared state fixture; load the initial_state fixture before dispatch.",
    "keyboard": "Dispatch the key with modifiers, then assert every field in the case's assert mapping.",
    "accessibility": "Capture the actual platform accessibility tree and compare declared semantics.",
    "screenshots": "Render each state/theme/scale case and compare its named baseline.",
    "custom_tests": null
  },
  "keyboard_cases": [
    {
      "id": "keyboard-01",
      "dispatch": {
        "key": "ArrowDown",
        "modifiers": []
      },
      "precondition": "layer panel is focused",
      "expected_behavior": "Move active row to the next visible row.",
      "initial_state": "mixed-tree",
      "load_fixture": "mixed_tree_fixture",
      "assert": {
        "event": "ActiveChanged"
      }
    },
    {
      "id": "keyboard-02",
      "dispatch": {
        "key": "ArrowUp",
        "modifiers": []
      },
      "precondition": "layer panel is focused",
      "expected_behavior": "Move active row to the previous visible row.",
      "initial_state": "mixed-tree",
      "load_fixture": "mixed_tree_fixture",
      "assert": {
        "event": "ActiveChanged"
      }
    },
    {
      "id": "keyboard-03",
      "dispatch": {
        "key": "ArrowRight",
        "modifiers": []
      },
      "precondition": "active row is a collapsed group",
      "expected_behavior": "Expand the active group.",
      "initial_state": "collapsed-group",
      "load_fixture": "collapsed_group_fixture",
      "assert": {
        "event": "GroupExpandedChanged"
      }
    },
    {
      "id": "keyboard-04",
      "dispatch": {
        "key": "ArrowLeft",
        "modifiers": []
      },
      "precondition": "active row is an expanded group",
      "expected_behavior": "Collapse the active group.",
      "initial_state": "mixed-tree",
      "load_fixture": "mixed_tree_fixture",
      "assert": {
        "event": "GroupExpandedChanged"
      }
    },
    {
      "id": "keyboard-05",
      "dispatch": {
        "key": "ArrowUp",
        "modifiers": [
          "Alt"
        ]
      },
      "precondition": "active row has a preceding sibling",
      "expected_behavior": "Move the active row before its preceding sibling.",
      "initial_state": "mixed-tree",
      "load_fixture": "mixed_tree_fixture",
      "assert": {
        "event": "ReorderRequested"
      }
    },
    {
      "id": "keyboard-06",
      "dispatch": {
        "key": "ArrowDown",
        "modifiers": [
          "Alt"
        ]
      },
      "precondition": "active row has a following sibling",
      "expected_behavior": "Move the active row after its following sibling.",
      "initial_state": "mixed-tree",
      "load_fixture": "mixed_tree_fixture",
      "assert": {
        "event": "ReorderRequested"
      }
    },
    {
      "id": "keyboard-07",
      "dispatch": {
        "key": "Space",
        "modifiers": []
      },
      "precondition": "a layer row is active",
      "expected_behavior": "Toggle layer visibility.",
      "initial_state": "mixed-tree",
      "load_fixture": "mixed_tree_fixture",
      "assert": {
        "event": "VisibilityChanged"
      }
    },
    {
      "id": "keyboard-08",
      "dispatch": {
        "key": "l",
        "modifiers": []
      },
      "precondition": "a layer row is active",
      "expected_behavior": "Toggle layer lock.",
      "initial_state": "mixed-tree",
      "load_fixture": "mixed_tree_fixture",
      "assert": {
        "event": "LockChanged"
      }
    }
  ],
  "accessibility_cases": [
    {
      "id": "a11y-mixed-tree",
      "state": "mixed-tree",
      "load_fixture": "mixed_tree_fixture",
      "expected_semantics": {
        "role": "tree",
        "properties": [
          {
            "name": "name",
            "value": "caller-provided panel label"
          },
          {
            "name": "treeitem",
            "value": "Each visible group and layer is a treeitem named by its label and exposes one-based level."
          },
          {
            "name": "expanded",
            "value": "Groups expose expanded state."
          },
          {
            "name": "selected",
            "value": "Active row exposes selected state."
          },
          {
            "name": "visible",
            "value": "A labeled toggle button within each layer row exposes visibility state."
          },
          {
            "name": "locked",
            "value": "A labeled toggle button within each layer row exposes lock state."
          }
        ]
      },
      "capture": "mkit_harness::AccessibilitySnapshot::capture",
      "requires_active_platform_a11y": true,
      "headless_inactive_result": "unsupported_pending"
