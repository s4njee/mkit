{
  "manifest_version": 1,
  "component": "select",
  "source_spec_version": 1,
  "adapter_contract": {
    "fixture": "Provide each declared state fixture; load the initial_state fixture before dispatch.",
    "keyboard": "Dispatch the key with modifiers, then assert every field in the case's assert mapping.",
    "accessibility": "Capture the actual platform accessibility tree and compare declared semantics.",
    "screenshots": "Render each state/theme/scale case and compare its named baseline.",
    "custom_tests": null
  },
  "keyboard_cases": [
    {
      "id": "keyboard-01",
      "dispatch": {
        "key": "ArrowDown",
        "modifiers": []
      },
      "precondition": "Select is focused",
      "expected_behavior": "Open and move active option to next enabled item.",
      "initial_state": "closed",
      "load_fixture": "closed_fixture",
      "assert": {
        "state": "open",
        "event": "open"
      }
    },
    {
      "id": "keyboard-02",
      "dispatch": {
        "key": "Enter",
        "modifiers": []
      },
      "precondition": "Popup is open",
      "expected_behavior": "Commit active option and close.",
      "initial_state": "open",
      "load_fixture": "open_fixture",
      "assert": {
        "state": "closed",
        "event": "change"
      }
    },
    {
      "id": "keyboard-03",
      "dispatch": {
        "key": "Escape",
        "modifiers": []
      },
      "precondition": "Popup is open",
      "expected_behavior": "Close without changing committed value.",
      "initial_state": "open",
      "load_fixture": "open_fixture",
      "assert": {
        "state": "closed"
      }
    },
    {
      "id": "keyboard-04",
      "dispatch": {
        "key": "Home",
        "modifiers": []
      },
      "precondition": "Popup is open",
      "expected_behavior": "Move active option to first enabled item and scroll it into view.",
      "initial_state": "open",
      "load_fixture": "open_fixture",
      "assert": {
        "state": "open"
      }
    },
    {
      "id": "keyboard-05",
      "dispatch": {
        "key": "End",
        "modifiers": []
      },
      "precondition": "Popup is open",
      "expected_behavior": "Move active option to last enabled item and scroll it into view.",
      "initial_state": "open",
      "load_fixture": "open_fixture",
      "assert": {
        "state": "open"
      }
    }
  ],
  "accessibility_cases": [
    {
      "id": "a11y-closed",
      "state": "closed",
      "load_fixture": "closed_fixture",
      "expected_semantics": {
        "role": "combobox",
        "properties": [
          {
            "name": "aria-haspopup",
            "value": "listbox"
          },
          {
            "name": "aria-value",
            "value": "selected option label or empty string"
          },
          {
            "name": "aria-expanded",
            "value": false
          }
        ]
      },
      "capture": "mkit_harness::AccessibilitySnapshot::capture",
      "requires_active_platform_a11y": true,
      "headless_inactive_result": "unsupported_pending"
    },
    {
      "id": "a11y-open",
      "state": "open",
      "load_fixture": "open_fixture",
      "expected_semantics": {
        "role": "combobox",
        "properties": [
          {
            "name": "aria-haspopup",
            "value": "listbox"
          },
          {
            "name": "aria-value",
            "value": "selected option label or empty string"
          },
          {
            "name": "aria-expanded",
            "value": true
          },
          {
            "name": "active descendant",
            "value": "active option while open"
          }
        ]
      },
      "capture": "mkit_harness::AccessibilitySnapshot::capture",
      "requires_active_platform_a11y": true,
      "headless_inactive_result": "unsupported_pending"
    },
    {
      "id": "a11y-disabled",
      "state": "disabled",
      "load_fixture": "disabled_fixture",
      "expected_semantics": {
        "role": "combobox",
        "properties": [
          {
            "name": "aria-haspopup",
            "value": "listbox"
          },
          {
            "name": "aria-value",
            "value": "selected option label or empty string"
          },
          {
            "name": "aria-disabled",
            "value": true
          }
        ]
      },
      "capture": "mkit_harness::AccessibilitySnapshot::capture",
      "requires_active_platform_a11y": true,
      "headless_inactive_result": "unsupported_pending"
    }
  ],
