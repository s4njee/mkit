{
  "manifest_version": 1,
  "component": "toast",
  "source_spec_version": 1,
  "adapter_contract": {
    "fixture": "Provide each declared state fixture; load the initial_state fixture before dispatch.",
    "keyboard": "Dispatch the key with modifiers, then assert every field in the case's assert mapping.",
    "accessibility": "Capture the actual platform accessibility tree and compare declared semantics.",
    "screenshots": "Render each state/theme/scale case and compare its named baseline.",
    "custom_tests": null
  },
  "keyboard_cases": [
    {
      "id": "keyboard-01",
      "dispatch": {
        "key": "Escape",
        "modifiers": []
      },
      "precondition": "surface is open and not busy",
      "expected_behavior": "Request dismissal.",
      "initial_state": "visible",
      "load_fixture": "toast_visible",
      "assert": {
        "state": "dismissed",
        "event": "OpenChanged(false)"
      }
    },
    {
      "id": "keyboard-02",
      "dispatch": {
        "key": "Escape",
        "modifiers": []
      },
      "precondition": "surface is open and busy",
      "expected_behavior": "Keep the surface open and emit no event.",
      "initial_state": "busy",
      "load_fixture": "toast_busy",
      "assert": {
        "state": "busy",
        "event": "none"
      }
    },
    {
      "id": "keyboard-03",
      "dispatch": {
        "key": "Escape",
        "modifiers": []
      },
      "precondition": "controlled surface is open",
      "expected_behavior": "Request dismissal while leaving the supplied open value unchanged.",
      "initial_state": "controlled",
      "load_fixture": "toast_controlled",
      "assert": {
        "state": "controlled",
        "event": "OpenChanged(false)"
      }
    }
  ],
  "accessibility_cases": [
    {
      "id": "a11y-visible",
      "state": "visible",
      "load_fixture": "toast_visible",
      "expected_semantics": {
        "role": "status",
        "properties": [
          {
            "name": "live",
            "value": "polite"
          }
        ]
      },
      "capture": "mkit_harness::AccessibilitySnapshot::capture",
      "requires_active_platform_a11y": true,
      "headless_inactive_result": "unsupported_pending"
    },
    {
      "id": "a11y-dismissed",
      "state": "dismissed",
      "load_fixture": "toast_dismissed",
      "expected_semantics": {
        "role": "status",
        "properties": []
      },
      "capture": "mkit_harness::AccessibilitySnapshot::capture",
      "requires_active_platform_a11y": true,
      "headless_inactive_result": "unsupported_pending"
    },
    {
      "id": "a11y-busy",
      "state": "busy",
      "load_fixture": "toast_busy",
      "expected_semantics": {
        "role": "status",
        "properties": []
      },
      "capture": "mkit_harness::AccessibilitySnapshot::capture",
      "requires_active_platform_a11y": true,
      "headless_inactive_result": "unsupported_pending"
    },
    {
      "id": "a11y-controlled",
      "state": "controlled",
      "load_fixture": "toast_controlled",
      "expected_semantics": {
        "role": "status",
        "properties": []
      },
      "capture": "mkit_harness::AccessibilitySnapshot::capture",
      "requires_active_platform_a11y": true,
      "headless_inactive_result": "unsupported_pending"
    }
  ],
