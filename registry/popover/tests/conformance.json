    {
      "id": "keyboard-01",
      "dispatch": {
        "key": "Escape",
        "modifiers": []
      },
      "precondition": "surface is open and not busy",
      "expected_behavior": "Request dismissal and restore focus to the trigger.",
      "initial_state": "open",
      "load_fixture": "popover_open",
      "assert": {
        "event": "OpenChanged"
      }
    }
  ],
