          },
          {
            "name": "orientation",
            "value": "horizontal"
          }
        ]
      },
      "capture": "mkit_harness::AccessibilitySnapshot::capture",
      "requires_active_platform_a11y": true,
      "headless_inactive_result": "unsupported_pending"
    },
    {
      "id": "a11y-disabled",
      "state": "disabled",
      "load_fixture": "toolbar_disabled",
      "expected_semantics": {
        "role": "toolbar",
        "properties": [
          {
            "name": "label",
            "value": "Document actions"
          },
          {
            "name": "orientation",
            "value": "horizontal"
          }
        ]
      },
      "capture": "mkit_harness::AccessibilitySnapshot::capture",
      "requires_active_platform_a11y": true,
      "headless_inactive_result": "unsupported_pending"
    }
  ],
