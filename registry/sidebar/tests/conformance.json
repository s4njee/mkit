{
  "manifest_version": 1,
  "component": "sidebar",
  "source_spec_version": 1,
  "adapter_contract": {
    "fixture": "Provide each declared state fixture; load the initial_state fixture before dispatch.",
    "keyboard": "Dispatch the key with modifiers, then assert every field in the case's assert mapping.",
    "accessibility": "Capture the actual platform accessibility tree and compare declared semantics.",
    "screenshots": "Render each state/theme/scale case and compare its named baseline.",
    "custom_tests": null
  },
  "keyboard_cases": [
    {
      "id": "keyboard-01",
      "dispatch": {
        "key": "Enter",
        "modifiers": []
      },
      "precondition": "an enabled navigation link is focused",
      "expected_behavior": "Request navigation to the focused link; controlled state changes only when the owner applies the requested current value.",
      "initial_state": "selection",
      "load_fixture": "sidebar_selection",
      "assert": {
        "event": "value_changed"
      }
    }
  ],
  "accessibility_cases": [
    {
      "id": "a11y-selection",
      "state": "selection",
      "load_fixture": "sidebar_selection",
      "expected_semantics": {
        "role": "navigation",
        "properties": [
          {
            "name": "label",
            "value": "Component label"
          },
          {
            "name": "child_role",
            "value": "link"
          },
          {
            "name": "current_page_description",
            "value": "Current page on the enabled link whose value is selected"
          }
        ]
      },
      "capture": "mkit_harness::AccessibilitySnapshot::capture",
      "requires_active_platform_a11y": true,
      "headless_inactive_result": "unsupported_pending"
    },
    {
      "id": "a11y-disabled",
      "state": "disabled",
      "load_fixture": "sidebar_disabled",
      "expected_semantics": {
        "role": "navigation",
        "properties": [
          {
            "name": "label",
            "value": "Component label"
          },
          {
            "name": "child_role",
            "value": "link"
          },
          {
            "name": "current_page_description",
            "value": "Current page on the enabled link whose value is selected"
          }
        ]
      },
      "capture": "mkit_harness::AccessibilitySnapshot::capture",
      "requires_active_platform_a11y": true,
      "headless_inactive_result": "unsupported_pending"
    }
  ],
