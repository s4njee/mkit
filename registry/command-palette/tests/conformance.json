            "name": "modal",
            "value": true
          },
          {
            "name": "name",
            "value": "Command palette"
          },
          {
            "name": "active-descendant-focus",
            "value": true
          },
          {
            "name": "focus-trap",
            "value": "search-only"
          }
        ]
      },
      "capture": "mkit_harness::AccessibilitySnapshot::capture",
      "requires_active_platform_a11y": true,
      "headless_inactive_result": "unsupported_pending"
    },
    {
      "id": "a11y-open_no_matches",
      "state": "open_no_matches",
      "load_fixture": "open_no_matches_fixture",
      "expected_semantics": {
        "role": "dialog",
        "properties": [
          {
            "name": "modal",
            "value": true
          },
          {
            "name": "name",
            "value": "Command palette"
