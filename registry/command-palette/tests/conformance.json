{
  "manifest_version": 1,
  "component": "command-palette",
  "source_spec_version": 1,
  "adapter_contract": {
    "fixture": "Provide each declared state fixture; load the initial_state fixture before dispatch.",
    "keyboard": "Dispatch the key with modifiers, then assert every field in the case's assert mapping.",
    "accessibility": "Capture the actual platform accessibility tree and compare declared semantics.",
    "screenshots": "Render each state/theme/scale case and compare its named baseline.",
    "custom_tests": null
  },
  "keyboard_cases": [
    {
      "id": "keyboard-01",
      "dispatch": {
        "key": "ArrowDown",
        "modifiers": []
      },
      "precondition": "Palette is open and results are available.",
      "expected_behavior": "Move the active result to the next match, wrapping at the end.",
      "initial_state": "open_filtered",
      "load_fixture": "open_filtered_fixture",
      "assert": {
        "state": "open_filtered",
        "focus_target": "search"
      }
    },
    {
      "id": "keyboard-02",
      "dispatch": {
        "key": "ArrowUp",
        "modifiers": []
      },
      "precondition": "Palette is open and results are available.",
      "expected_behavior": "Move the active result to the previous match, wrapping at the start.",
      "initial_state": "open_filtered",
      "load_fixture": "open_filtered_fixture",
      "assert": {
        "state": "open_filtered",
        "focus_target": "search"
      }
    },
    {
      "id": "keyboard-03",
      "dispatch": {
        "key": "Enter",
        "modifiers": []
      },
      "precondition": "Palette is open with an active result.",
      "expected_behavior": "Emit activation for the active registered action and close the palette.",
      "initial_state": "open_filtered",
      "load_fixture": "open_filtered_fixture",
      "assert": {
        "state": "closed",
        "event": "activate",
        "focus_target": "caller"
      }
    },
    {
      "id": "keyboard-04",
      "dispatch": {
        "key": "Escape",
        "modifiers": []
      },
      "precondition": "Palette is open.",
      "expected_behavior": "Close the palette without activating an action.",
      "initial_state": "open_filtered",
      "load_fixture": "open_filtered_fixture",
      "assert": {
        "state": "closed",
        "event": "close",
        "focus_target": "caller"
      }
    },
    {
      "id": "keyboard-05",
      "dispatch": {
        "key": "Tab",
        "modifiers": []
      },
      "precondition": "Palette is open.",
      "expected_behavior": "Keep keyboard focus on Search (the palette's only focus stop).",
      "initial_state": "open_filtered",
      "load_fixture": "open_filtered_fixture",
      "assert": {
        "state": "open_filtered",
        "focus_target": "search"
      }
    },
    {
      "id": "keyboard-06",
      "dispatch": {
        "key": "Tab",
        "modifiers": [
          "Shift"
        ]
      },
      "precondition": "Palette is open.",
      "expected_behavior": "Keep keyboard focus on Search (the palette's only focus stop).",
      "initial_state": "open_filtered",
      "load_fixture": "open_filtered_fixture",
      "assert": {
        "state": "open_filtered",
        "focus_target": "search"
      }
    }
  ],
  "accessibility_cases": [
    {
      "id": "a11y-closed",
      "state": "closed",
      "load_fixture": "closed_fixture",
      "expected_semantics": {
        "role": "dialog",
        "properties": []
      },
      "capture": "mkit_harness::AccessibilitySnapshot::capture",
      "requires_active_platform_a11y": true,
      "headless_inactive_result": "unsupported_pending"
    },
    {
      "id": "a11y-open_empty",
      "state": "open_empty",
      "load_fixture": "open_empty_fixture",
      "expected_semantics": {
        "role": "dialog",
        "properties": [
          {
            "name": "modal",
            "value": true
          },
          {
            "name": "name",
            "value": "Command palette"
          },
          {
            "name": "focus-trap",
            "value": "search-only"
          }
        ]
      },
      "capture": "mkit_harness::AccessibilitySnapshot::capture",
      "requires_active_platform_a11y": true,
      "headless_inactive_result": "unsupported_pending"
    },
    {
      "id": "a11y-open_filtered",
