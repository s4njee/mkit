        "key": "ArrowUp",
        "modifiers": []
      },
      "precondition": "The hue-saturation wheel has focus.",
      "expected_behavior": "Increase hue by one degree.",
      "initial_state": "selected",
      "load_fixture": "selected_fixture",
      "assert": {
        "event": "colour_changed"
      }
    },
    {
      "id": "keyboard-04",
      "dispatch": {
        "key": "ArrowDown",
        "modifiers": []
      },
      "precondition": "The hue-saturation wheel has focus.",
      "expected_behavior": "Decrease hue by one degree.",
      "initial_state": "selected",
      "load_fixture": "selected_fixture",
      "assert": {
        "event": "colour_changed"
      }
    },
    {
      "id": "keyboard-05",
      "dispatch": {
        "key": "Shift-ArrowUp",
        "modifiers": [
          "shift"
        ]
      },
      "precondition": "The hue-saturation wheel has focus.",
      "expected_behavior": "Increase lightness by one percent.",
      "initial_state": "selected",
      "load_fixture": "selected_fixture",
      "assert": {
        "event": "colour_changed"
      }
    },
    {
      "id": "keyboard-06",
      "dispatch": {
        "key": "Shift-ArrowDown",
        "modifiers": [
          "shift"
        ]
      },
      "precondition": "The hue-saturation wheel has focus.",
      "expected_behavior": "Decrease lightness by one percent.",
      "initial_state": "selected",
      "load_fixture": "selected_fixture",
      "assert": {
        "event": "colour_changed"
      }
    }
