{
  "manifest_version": 1,
  "component": "reorderable-list",
  "source_spec_version": 1,
  "adapter_contract": {
    "fixture": "Provide each declared state fixture; load the initial_state fixture before dispatch.",
    "keyboard": "Dispatch the key with modifiers, then assert every field in the case's assert mapping.",
    "accessibility": "Capture the actual platform accessibility tree and compare declared semantics.",
    "screenshots": "Render each state/theme/scale case and compare its named baseline.",
    "custom_tests": null
  },
  "keyboard_cases": [
    {
      "id": "keyboard-01",
      "dispatch": {
        "key": "ArrowUp",
        "modifiers": [
          "Alt"
        ]
      },
      "precondition": "An enabled row is active and has a predecessor.",
      "expected_behavior": "Move the active row up one position.",
      "initial_state": "default",
      "load_fixture": "default_fixture",
      "assert": {
        "event": "ReorderRequested"
      }
    },
    {
      "id": "keyboard-02",
      "dispatch": {
        "key": "ArrowDown",
        "modifiers": [
          "Alt"
        ]
      },
      "precondition": "An enabled row is active and has a successor.",
      "expected_behavior": "Move the active row down one position.",
      "initial_state": "default",
      "load_fixture": "default_fixture",
      "assert": {
        "event": "ReorderRequested"
      }
    }
  ],
