{
  "manifest_version": 1,
  "component": "gradient-editor",
  "source_spec_version": 1,
  "adapter_contract": {
    "fixture": "Provide each declared state fixture; load the initial_state fixture before dispatch.",
    "keyboard": "Dispatch the key with modifiers, then assert every field in the case's assert mapping.",
    "accessibility": "Capture the actual platform accessibility tree and compare declared semantics.",
    "screenshots": "Render each state/theme/scale case and compare its named baseline.",
    "custom_tests": null
  },
  "keyboard_cases": [
    {
      "id": "keyboard-01",
      "dispatch": {
        "key": "ArrowLeft",
        "modifiers": []
      },
      "precondition": "A stop is selected.",
      "expected_behavior": "Move selected stop left by one percent, clamped between neighbouring stops.",
      "initial_state": "selected-stop",
      "load_fixture": "selected_stop_fixture",
      "assert": {
        "event": "gradient_changed"
      }
    },
    {
      "id": "keyboard-02",
      "dispatch": {
        "key": "ArrowRight",
        "modifiers": []
      },
      "precondition": "A stop is selected.",
      "expected_behavior": "Move selected stop right by one percent, clamped between neighbouring stops.",
      "initial_state": "selected-stop",
      "load_fixture": "selected_stop_fixture",
      "assert": {
        "event": "gradient_changed"
      }
    },
    {
      "id": "keyboard-03",
      "dispatch": {
        "key": "Shift-ArrowLeft",
        "modifiers": [
          "shift"
        ]
      },
      "precondition": "A stop is selected.",
      "expected_behavior": "Move selected stop left by one tenth percent, clamped between neighbouring stops.",
      "initial_state": "selected-stop",
      "load_fixture": "selected_stop_fixture",
      "assert": {
        "event": "gradient_changed"
      }
    },
    {
      "id": "keyboard-04",
      "dispatch": {
        "key": "Shift-ArrowRight",
        "modifiers": [
          "shift"
        ]
      },
      "precondition": "A stop is selected.",
      "expected_behavior": "Move selected stop right by one tenth percent, clamped between neighbouring stops.",
      "initial_state": "selected-stop",
      "load_fixture": "selected_stop_fixture",
      "assert": {
        "event": "gradient_changed"
      }
    },
    {
      "id": "keyboard-05",
      "dispatch": {
        "key": "Delete",
        "modifiers": []
      },
      "precondition": "A non-endpoint stop is selected.",
      "expected_behavior": "Delete the selected stop.",
      "initial_state": "many-stops",
      "load_fixture": "many_stops_fixture",
      "assert": {
        "event": "gradient_changed"
      }
    },
    {
      "id": "keyboard-06",
      "dispatch": {
        "key": "Home",
        "modifiers": []
      },
      "precondition": "An interior stop is selected.",
      "expected_behavior": "Move the selected stop as far left as neighbouring-stop spacing allows.",
      "initial_state": "selected-stop",
      "load_fixture": "selected_stop_fixture",
      "assert": {
        "event": "gradient_changed"
      }
    },
    {
      "id": "keyboard-07",
      "dispatch": {
        "key": "End",
        "modifiers": []
      },
      "precondition": "An interior stop is selected.",
      "expected_behavior": "Move the selected stop as far right as neighbouring-stop spacing allows.",
      "initial_state": "selected-stop",
      "load_fixture": "selected_stop_fixture",
      "assert": {
        "event": "gradient_changed"
      }
    },
    {
      "id": "keyboard-08",
      "dispatch": {
        "key": "Tab",
        "modifiers": []
      },
      "precondition": "The gradient editor has focus.",
      "expected_behavior": "Select the next stop.",
      "initial_state": "selected-stop",
      "load_fixture": "selected_stop_fixture",
      "assert": {
        "event": "stop_selected"
      }
    },
    {
      "id": "keyboard-09",
      "dispatch": {
        "key": "r",
        "modifiers": []
      },
      "precondition": "A stop is selected.",
