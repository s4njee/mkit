{
  "manifest_version": 1,
  "component": "toggle-group",
  "source_spec_version": 1,
  "adapter_contract": {
    "fixture": "Provide each declared state fixture; load the initial_state fixture before dispatch.",
    "keyboard": "Dispatch the key with modifiers, then assert every field in the case's assert mapping.",
    "accessibility": "Capture the actual platform accessibility tree and compare declared semantics.",
    "screenshots": "Render each state/theme/scale case and compare its named baseline.",
    "custom_tests": null
  },
  "keyboard_cases": [
    {
      "id": "keyboard-01",
      "dispatch": {
        "key": "ArrowRight",
        "modifiers": []
      },
      "precondition": "a group item is focused in a horizontal group",
      "expected_behavior": "Move focus to and select the next enabled item, wrapping at the end.",
      "initial_state": "selection",
      "load_fixture": "toggle_group_selection",
      "assert": {
        "event": "value_changed",
        "focus_target": "next_enabled_item"
      }
    },
    {
      "id": "keyboard-02",
      "dispatch": {
        "key": "ArrowLeft",
        "modifiers": []
      },
      "precondition": "a group item is focused in a horizontal group",
      "expected_behavior": "Move focus to and select the previous enabled item, wrapping at the beginning.",
      "initial_state": "selection",
      "load_fixture": "toggle_group_selection",
      "assert": {
        "event": "value_changed",
        "focus_target": "previous_enabled_item"
      }
    },
    {
      "id": "keyboard-03",
      "dispatch": {
        "key": "ArrowDown",
        "modifiers": []
      },
      "precondition": "a group item is focused in a vertical group",
      "expected_behavior": "Move focus to and select the next enabled item, wrapping at the end.",
      "initial_state": "selection",
      "load_fixture": "toggle_group_selection",
      "assert": {
        "event": "value_changed",
        "focus_target": "next_enabled_item"
      }
    },
    {
      "id": "keyboard-04",
      "dispatch": {
        "key": "ArrowUp",
        "modifiers": []
      },
      "precondition": "a group item is focused in a vertical group",
      "expected_behavior": "Move focus to and select the previous enabled item, wrapping at the beginning.",
      "initial_state": "selection",
      "load_fixture": "toggle_group_selection",
      "assert": {
        "event": "value_changed",
        "focus_target": "previous_enabled_item"
      }
    },
    {
      "id": "keyboard-05",
      "dispatch": {
        "key": "Home",
        "modifiers": []
      },
      "precondition": "a group item is focused",
      "expected_behavior": "Move focus to and select the first enabled item.",
      "initial_state": "selection",
      "load_fixture": "toggle_group_selection",
      "assert": {
        "event": "value_changed",
        "focus_target": "first_enabled_item"
      }
    },
    {
      "id": "keyboard-06",
      "dispatch": {
        "key": "End",
        "modifiers": []
      },
      "precondition": "a group item is focused",
      "expected_behavior": "Move focus to and select the last enabled item.",
      "initial_state": "selection",
      "load_fixture": "toggle_group_selection",
      "assert": {
        "event": "value_changed",
        "focus_target": "last_enabled_item"
      }
    }
  ],
  "accessibility_cases": [
    {
      "id": "a11y-selection",
      "state": "selection",
      "load_fixture": "toggle_group_selection",
      "expected_semantics": {
        "role": "group",
        "properties": [
          {
            "name": "label",
            "value": "Group label"
          }
        ]
      },
      "capture": "mkit_harness::AccessibilitySnapshot::capture",
      "requires_active_platform_a11y": true,
      "headless_inactive_result": "unsupported_pending"
    },
    {
      "id": "a11y-disabled",
      "state": "disabled",
      "load_fixture": "toggle_group_disabled",
      "expected_semantics": {
        "role": "group",
        "properties": [
          {
            "name": "aria-disabled",
            "value": true
          }
        ]
      },
      "capture": "mkit_harness::AccessibilitySnapshot::capture",
      "requires_active_platform_a11y": true,
      "headless_inactive_result": "unsupported_pending"
    }
  ],
