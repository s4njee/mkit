{
  "manifest_version": 1,
  "component": "date-time-field",
  "source_spec_version": 1,
  "adapter_contract": {
    "fixture": "Provide each declared state fixture; load the initial_state fixture before dispatch.",
    "keyboard": "Dispatch the key with modifiers, then assert every field in the case's assert mapping.",
    "accessibility": "Capture the actual platform accessibility tree and compare declared semantics.",
    "screenshots": "Render each state/theme/scale case and compare its named baseline.",
    "custom_tests": null
  },
  "keyboard_cases": [
    {
      "id": "keyboard-01",
      "dispatch": {
        "key": "ArrowDown",
        "modifiers": [
          "Alt"
        ]
      },
      "precondition": "Date input is focused.",
      "expected_behavior": "Open the composed DatePicker calendar.",
      "initial_state": "complete",
      "load_fixture": "complete_fixture",
      "assert": {
        "state": "date_picker_open"
      }
    },
    {
      "id": "keyboard-02",
      "dispatch": {
        "key": "ArrowUp",
        "modifiers": []
      },
      "precondition": "A time segment is focused.",
      "expected_behavior": "Increment the focused time segment.",
      "initial_state": "time_segment_focused",
      "load_fixture": "time_segment_focused_fixture",
      "assert": {
        "event": "TimeChanged"
      }
    }
  ],
