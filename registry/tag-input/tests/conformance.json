{
  "manifest_version": 1,
  "component": "tag-input",
  "source_spec_version": 1,
  "adapter_contract": {
    "fixture": "Provide each declared state fixture; load the initial_state fixture before dispatch.",
    "keyboard": "Dispatch the key with modifiers, then assert every field in the case's assert mapping.",
    "accessibility": "Capture the actual platform accessibility tree and compare declared semantics.",
    "screenshots": "Render each state/theme/scale case and compare its named baseline.",
    "custom_tests": null
  },
  "keyboard_cases": [
    {
      "id": "keyboard-01",
      "dispatch": {
        "key": "Enter",
        "modifiers": []
      },
      "precondition": "Editor is enabled and a non-empty query is present.",
      "expected_behavior": "Add the active suggestion, or otherwise add the trimmed query as a tag; emit a typed tags-change proposal when accepted.",
      "initial_state": "query",
      "load_fixture": "query_fixture",
      "assert": {
        "state": "tags",
        "event": "TagsChanged",
        "focus_target": "editor"
      }
    },
    {
      "id": "keyboard-02",
      "dispatch": {
        "key": "ArrowDown",
        "modifiers": []
      },
      "precondition": "Editor query has filtered suggestions.",
      "expected_behavior": "Activate the first enabled suggestion or advance to the next enabled suggestion without moving focus from the editor.",
      "initial_state": "suggestions",
      "load_fixture": "suggestions_fixture",
      "assert": {
        "state": "suggestions",
        "focus_target": "editor"
      }
    },
    {
      "id": "keyboard-03",
      "dispatch": {
        "key": "ArrowUp",
        "modifiers": []
      },
      "precondition": "Editor query has filtered suggestions.",
      "expected_behavior": "Activate the last enabled suggestion or move to the previous enabled suggestion without moving focus from the editor.",
      "initial_state": "suggestions",
      "load_fixture": "suggestions_fixture",
      "assert": {
        "state": "suggestions",
        "focus_target": "editor"
      }
    },
    {
      "id": "keyboard-04",
      "dispatch": {
        "key": "Comma",
        "modifiers": []
      },
      "precondition": "Editor is enabled and a non-empty query is present.",
      "expected_behavior": "Add the trimmed query as a tag; comma is not included in the tag value.",
      "initial_state": "query",
      "load_fixture": "query_fixture",
      "assert": {
        "state": "tags",
        "event": "TagsChanged",
        "focus_target": "editor"
      }
    },
    {
      "id": "keyboard-05",
      "dispatch": {
        "key": "Backspace",
        "modifiers": []
      },
      "precondition": "Editor is empty and tags are present.",
      "expected_behavior": "Select the last tag, or remove the selected tag on a second Backspace; emit TagsChanged only on removal.",
      "initial_state": "tags",
      "load_fixture": "tags_fixture",
      "assert": {
        "state": "selected_tag",
        "focus_target": "editor"
      }
    },
    {
      "id": "keyboard-06",
      "dispatch": {
        "key": "ArrowLeft",
        "modifiers": []
      },
      "precondition": "Editor is empty and tags are present or a tag is selected.",
      "expected_behavior": "Select the last tag or move selection to the preceding tag without moving focus from the editor.",
      "initial_state": "tags",
      "load_fixture": "tags_fixture",
      "assert": {
        "state": "selected_tag",
        "focus_target": "editor"
      }
    },
    {
      "id": "keyboard-07",
      "dispatch": {
        "key": "ArrowRight",
        "modifiers": []
      },
      "precondition": "A tag is selected.",
      "expected_behavior": "Move selection to the next tag; after the last tag, clear tag selection and keep focus in the editor.",
      "initial_state": "selected_tag",
      "load_fixture": "selected_tag_fixture",
      "assert": {
        "state": "tags",
        "focus_target": "editor"
      }
    },
    {
      "id": "keyboard-08",
      "dispatch": {
        "key": "Delete",
        "modifiers": []
      },
      "precondition": "A tag is selected and the editor is enabled.",
      "expected_behavior": "Remove the selected tag and emit TagsChanged.",
      "initial_state": "selected_tag",
      "load_fixture": "selected_tag_fixture",
      "assert": {
        "state": "tags",
        "event": "TagsChanged",
        "focus_target": "editor"
      }
    },
    {
      "id": "keyboard-09",
      "dispatch": {
        "key": "Escape",
        "modifiers": []
      },
      "precondition": "A suggestion is active or a tag is selected.",
      "expected_behavior": "Clear suggestion and tag selection without changing tags or query.",
      "initial_state": "suggestions",
      "load_fixture": "suggestions_fixture",
      "assert": {
        "state": "tags",
        "focus_target": "editor"
      }
    }
  ],
