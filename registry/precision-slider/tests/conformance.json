{
  "manifest_version": 1,
  "component": "precision-slider",
  "source_spec_version": 1,
  "adapter_contract": {
    "fixture": "Provide each declared state fixture; load the initial_state fixture before dispatch.",
    "keyboard": "Dispatch the key with modifiers, then assert every field in the case's assert mapping.",
    "accessibility": "Capture the actual platform accessibility tree and compare declared semantics.",
    "screenshots": "Render each state/theme/scale case and compare its named baseline.",
    "custom_tests": null
  },
  "keyboard_cases": [
    {
      "id": "keyboard-01",
      "dispatch": {
        "key": "ArrowRight",
        "modifiers": []
      },
      "precondition": "Enabled slider is focused.",
      "expected_behavior": "Increase by one regular step.",
      "initial_state": "middle",
      "load_fixture": "middle_fixture",
      "assert": {
        "event": "change_requested"
      }
    },
    {
      "id": "keyboard-02",
      "dispatch": {
        "key": "ArrowLeft",
        "modifiers": []
      },
      "precondition": "Enabled slider is focused.",
      "expected_behavior": "Decrease by one regular step.",
      "initial_state": "middle",
      "load_fixture": "middle_fixture",
      "assert": {
        "event": "change_requested"
      }
    },
    {
      "id": "keyboard-03",
      "dispatch": {
        "key": "ArrowRight",
        "modifiers": [
          "Shift"
        ]
      },
      "precondition": "Enabled slider is focused.",
      "expected_behavior": "Increase by one tenth of a regular step.",
      "initial_state": "middle",
      "load_fixture": "middle_fixture",
      "assert": {
        "event": "change_requested"
      }
    },
    {
      "id": "keyboard-04",
      "dispatch": {
        "key": "r",
        "modifiers": []
      },
      "precondition": "Enabled slider is focused.",
      "expected_behavior": "Request the configured reset value.",
      "initial_state": "middle",
      "load_fixture": "middle_fixture",
      "assert": {
        "event": "change_requested"
      }
    }
  ],
  "accessibility_cases": [
    {
      "id": "a11y-minimum",
      "state": "minimum",
      "load_fixture": "minimum_fixture",
      "expected_semantics": {
        "role": "slider",
        "properties": [
          {
            "name": "aria-valuemin",
            "value": "configured minimum"
          },
          {
            "name": "aria-valuemax",
            "value": "configured maximum"
          },
          {
            "name": "aria-valuenow",
            "value": "current value"
          }
        ]
      },
      "capture": "mkit_harness::AccessibilitySnapshot::capture",
      "requires_active_platform_a11y": true,
      "headless_inactive_result": "unsupported_pending"
    },
