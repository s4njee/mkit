{
  "manifest_version": 1,
  "component": "segmented-control",
  "source_spec_version": 1,
  "adapter_contract": {
    "fixture": "Provide each declared state fixture; load the initial_state fixture before dispatch.",
    "keyboard": "Dispatch the key with modifiers, then assert every field in the case's assert mapping.",
    "accessibility": "Capture the actual platform accessibility tree and compare declared semantics.",
    "screenshots": "Render each state/theme/scale case and compare its named baseline.",
    "custom_tests": null
  },
  "keyboard_cases": [
    {
      "id": "keyboard-01",
      "dispatch": {
        "key": "ArrowRight",
        "modifiers": []
      },
      "precondition": "an option is focused in horizontal orientation",
      "expected_behavior": "Focus and select the next enabled option with wrapping.",
      "initial_state": "selection",
      "load_fixture": "segmented_control_selection",
      "assert": {
        "state": "selected_three",
        "focus_target": "three",
        "event": "selection_changed"
      }
    },
    {
      "id": "keyboard-02",
      "dispatch": {
        "key": "ArrowLeft",
        "modifiers": []
      },
      "precondition": "an option is focused in horizontal orientation",
      "expected_behavior": "Focus and select the previous enabled option with wrapping.",
      "initial_state": "selection",
      "load_fixture": "segmented_control_selection",
      "assert": {
        "state": "selected_three",
        "focus_target": "three",
        "event": "selection_changed"
      }
    },
    {
      "id": "keyboard-03",
      "dispatch": {
        "key": "Home",
        "modifiers": []
      },
      "precondition": "an option is focused",
      "expected_behavior": "Focus and select the first enabled option.",
      "initial_state": "selection",
      "load_fixture": "segmented_control_selection",
      "assert": {
        "state": "selection",
        "focus_target": "one",
        "event": "none"
      }
    },
    {
      "id": "keyboard-04",
      "dispatch": {
        "key": "End",
        "modifiers": []
      },
      "precondition": "an option is focused",
      "expected_behavior": "Focus and select the last enabled option.",
      "initial_state": "selection",
      "load_fixture": "segmented_control_selection",
      "assert": {
        "state": "selected_three",
        "focus_target": "three",
        "event": "selection_changed"
      }
    },
    {
      "id": "keyboard-05",
      "dispatch": {
        "key": "Space",
        "modifiers": []
      },
      "precondition": "an option is focused and no option is selected",
      "expected_behavior": "Select the focused option.",
      "initial_state": "empty",
      "load_fixture": "segmented_control_empty",
      "assert": {
        "state": "selection",
        "focus_target": "one",
        "event": "selection_changed"
      }
    },
    {
      "id": "keyboard-06",
      "dispatch": {
        "key": "ArrowRight",
        "modifiers": []
      },
      "precondition": "the radio group is disabled",
      "expected_behavior": "Keep focus and selection unchanged without emitting an event.",
      "initial_state": "disabled",
      "load_fixture": "segmented_control_disabled",
      "assert": {
        "state": "disabled",
        "focus_target": "none",
        "event": "none"
      }
    },
    {
      "id": "keyboard-07",
      "dispatch": {
        "key": "ArrowRight",
        "modifiers": []
      },
      "precondition": "a controlled radio group has the first option selected",
      "expected_behavior": "Request the next option and focus it without changing controlled selection.",
      "initial_state": "controlled",
      "load_fixture": "segmented_control_controlled",
      "assert": {
        "state": "controlled",
        "focus_target": "three",
        "event": "selection_changed"
      }
    },
    {
      "id": "keyboard-08",
      "dispatch": {
        "key": "ArrowDown",
        "modifiers": []
      },
      "precondition": "an option is focused in vertical orientation",
      "expected_behavior": "Focus and select the next enabled option with wrapping.",
      "initial_state": "vertical",
      "load_fixture": "segmented_control_vertical",
      "assert": {
        "state": "selected_three",
        "focus_target": "three",
        "event": "selection_changed"
      }
    }
  ],
  "accessibility_cases": [
    {
      "id": "a11y-selection",
      "state": "selection",
      "load_fixture": "segmented_control_selection",
      "expected_semantics": {
        "role": "radiogroup",
        "properties": [
          {
            "name": "label",
            "value": "Views"
          },
          {
            "name": "orientation",
            "value": "horizontal by default; vertical when configured"
          }
        ]
      },
      "capture": "mkit_harness::AccessibilitySnapshot::capture",
      "requires_active_platform_a11y": true,
      "headless_inactive_result": "unsupported_pending"
    },
