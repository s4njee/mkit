{
  "manifest_version": 1,
  "component": "combobox",
  "source_spec_version": 1,
  "adapter_contract": {
    "fixture": "Provide each declared state fixture; load the initial_state fixture before dispatch.",
    "keyboard": "Dispatch the key with modifiers, then assert every field in the case's assert mapping.",
    "accessibility": "Capture the actual platform accessibility tree and compare declared semantics.",
    "screenshots": "Render each state/theme/scale case and compare its named baseline.",
    "custom_tests": null
  },
  "keyboard_cases": [
    {
      "id": "keyboard-01",
      "dispatch": {
        "key": "ArrowDown",
        "modifiers": []
      },
      "precondition": "Editable input is focused and popup is closed.",
      "expected_behavior": "Open the popup and make the first enabled matching option active.",
      "initial_state": "closed_empty",
      "load_fixture": "closed_empty_fixture",
      "assert": {
        "state": "open_unfiltered_active",
        "event": "open",
        "focus_target": "input"
      }
    },
    {
      "id": "keyboard-02",
      "dispatch": {
        "key": "ArrowDown",
        "modifiers": []
      },
      "precondition": "Popup is open with an active option.",
      "expected_behavior": "Move the active option to the next enabled matching option, without moving DOM/platform focus from the input.",
      "initial_state": "open_filtered",
      "load_fixture": "open_filtered_fixture",
      "assert": {
        "state": "open_filtered",
        "focus_target": "input"
      }
    },
    {
      "id": "keyboard-03",
      "dispatch": {
        "key": "ArrowUp",
        "modifiers": []
      },
      "precondition": "Popup is open with an active option.",
      "expected_behavior": "Move the active option to the previous enabled matching option, without moving focus from the input.",
      "initial_state": "open_filtered",
      "load_fixture": "open_filtered_fixture",
      "assert": {
        "state": "open_filtered",
        "focus_target": "input"
      }
    },
    {
      "id": "keyboard-04",
      "dispatch": {
        "key": "Enter",
        "modifiers": []
      },
      "precondition": "Popup is open with an active option.",
      "expected_behavior": "Commit the active option and close the popup.",
      "initial_state": "open_filtered",
      "load_fixture": "open_filtered_fixture",
      "assert": {
        "state": "closed_committed",
        "event": "commit",
        "focus_target": "input"
      }
    },
    {
      "id": "keyboard-05",
      "dispatch": {
        "key": "Escape",
        "modifiers": []
      },
      "precondition": "Popup is open after editing or navigating suggestions.",
      "expected_behavior": "Cancel the current popup session, restore the value from before that session, and close the popup.",
      "initial_state": "open_filtered",
      "load_fixture": "open_filtered_fixture",
      "assert": {
        "state": "closed_committed",
        "event": "cancel",
        "focus_target": "input"
      }
    },
    {
      "id": "keyboard-06",
      "dispatch": {
        "key": "Tab",
        "modifiers": []
      },
      "precondition": "Popup is open.",
      "expected_behavior": "Close the popup, preserve the typed draft without committing the active suggestion, and allow normal forward focus traversal.",
      "initial_state": "open_filtered",
      "load_fixture": "open_filtered_fixture",
      "assert": {
        "state": "closed_draft",
        "event": "dismiss",
        "focus_target": "next"
      }
    },
    {
      "id": "keyboard-07",
      "dispatch": {
        "key": "Tab",
        "modifiers": [
          "Shift"
        ]
      },
      "precondition": "Popup is open.",
      "expected_behavior": "Close the popup, preserve the typed draft without committing the active suggestion, and allow normal backward focus traversal.",
      "initial_state": "open_filtered",
      "load_fixture": "open_filtered_fixture",
      "assert": {
        "state": "closed_draft",
        "event": "dismiss",
        "focus_target": "previous"
      }
    },
    {
      "id": "keyboard-08",
      "dispatch": {
        "key": "ArrowDown",
        "modifiers": []
      },
      "precondition": "Editable input is focused and popup is closed with a committed value.",
      "expected_behavior": "Open the popup and activate the first enabled matching option.",
      "initial_state": "closed_committed",
      "load_fixture": "closed_committed_fixture",
      "assert": {
        "state": "open_filtered",
        "event": "open",
        "focus_target": "input"
      }
    },
    {
      "id": "keyboard-09",
      "dispatch": {
        "key": "ArrowDown",
        "modifiers": [
          "Alt"
        ]
      },
      "precondition": "Editable input is focused and popup is closed.",
      "expected_behavior": "Open the popup without changing the text or moving focus from the input.",
      "initial_state": "closed_empty",
      "load_fixture": "closed_empty_fixture",
      "assert": {
        "state": "open_empty",
        "event": "open",
        "focus_target": "input"
      }
    }
  ],
