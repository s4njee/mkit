{
  "manifest_version": 1,
  "component": "shortcut-editor",
  "source_spec_version": 1,
  "adapter_contract": {
    "fixture": "Provide each declared state fixture; load the initial_state fixture before dispatch.",
    "keyboard": "Dispatch the key with modifiers, then assert every field in the case's assert mapping.",
    "accessibility": "Capture the actual platform accessibility tree and compare declared semantics.",
    "screenshots": "Render each state/theme/scale case and compare its named baseline.",
    "custom_tests": null
  },
  "keyboard_cases": [
    {
      "id": "keyboard-01",
      "dispatch": {
        "key": "ArrowDown",
        "modifiers": []
      },
      "precondition": "editor is focused",
      "expected_behavior": "Select the next binding row, wrapping at the end.",
      "initial_state": "viewing",
      "load_fixture": "viewing_fixture",
      "assert": {
        "state": "viewing"
      }
    },
    {
      "id": "keyboard-02",
      "dispatch": {
        "key": "ArrowUp",
        "modifiers": []
      },
      "precondition": "editor is focused",
      "expected_behavior": "Select the previous binding row, wrapping at the start.",
      "initial_state": "viewing",
      "load_fixture": "viewing_fixture",
      "assert": {
        "state": "viewing"
      }
    },
    {
      "id": "keyboard-03",
      "dispatch": {
        "key": "Enter",
        "modifiers": []
      },
      "precondition": "a binding row is selected",
      "expected_behavior": "Begin capturing a replacement chord.",
      "initial_state": "viewing",
      "load_fixture": "viewing_fixture",
      "assert": {
        "state": "capturing"
      }
    },
    {
      "id": "keyboard-04",
      "dispatch": {
        "key": "Escape",
        "modifiers": []
      },
      "precondition": "capturing or a conflict is pending",
      "expected_behavior": "Cancel capture and keep the existing binding.",
      "initial_state": "capturing",
      "load_fixture": "capturing_fixture",
      "assert": {
        "state": "viewing"
      }
    },
    {
      "id": "keyboard-05",
      "dispatch": {
        "key": "Escape",
        "modifiers": []
      },
      "precondition": "capturing or a conflict is pending",
      "expected_behavior": "Cancel capture and keep the existing binding.",
      "initial_state": "conflict",
      "load_fixture": "conflict_fixture",
      "assert": {
        "state": "viewing"
      }
    },
    {
      "id": "keyboard-06",
      "dispatch": {
        "key": "Enter",
        "modifiers": []
      },
      "precondition": "a conflicting chord is pending",
      "expected_behavior": "Move the chord from the conflicting action to the selected action.",
      "initial_state": "conflict",
      "load_fixture": "conflict_fixture",
      "assert": {
        "state": "dirty"
      }
    },
    {
      "id": "keyboard-07",
      "dispatch": {
        "key": "Delete",
        "modifiers": []
      },
      "precondition": "a binding row is selected and not capturing",
      "expected_behavior": "Clear the selected binding.",
      "initial_state": "viewing",
      "load_fixture": "viewing_fixture",
      "assert": {
        "state": "dirty"
      }
    }
  ],
  "accessibility_cases": [
    {
      "id": "a11y-viewing",
      "state": "viewing",
      "load_fixture": "viewing_fixture",
      "expected_semantics": {
        "role": "grid",
        "properties": [
          {
            "name": "name",
            "value": "Keyboard shortcuts"
          },
          {
            "name": "row",
            "value": "Each action row exposes its label, current chord, and conflict status."
          },
          {
            "name": "selected",
            "value": "The selected row is exposed as selected."
          },
          {
            "name": "live-status",
            "value": "Capture, conflict, save success, and save errors are announced as status text."
          }
        ]
      },
      "capture": "mkit_harness::AccessibilitySnapshot::capture",
      "requires_active_platform_a11y": true,
