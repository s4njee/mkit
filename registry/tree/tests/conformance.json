{
  "manifest_version": 1,
  "component": "tree",
  "source_spec_version": 1,
  "adapter_contract": {
    "fixture": "Provide each declared state fixture; load the initial_state fixture before dispatch.",
    "keyboard": "Dispatch the key with modifiers, then assert every field in the case's assert mapping.",
    "accessibility": "Capture the actual platform accessibility tree and compare declared semantics.",
    "screenshots": "Render each state/theme/scale case and compare its named baseline.",
    "custom_tests": null
  },
  "keyboard_cases": [
    {
      "id": "keyboard-01",
      "dispatch": {
        "key": "ArrowDown",
        "modifiers": []
      },
      "precondition": "tree is focused",
      "expected_behavior": "Move to the next visible node.",
      "initial_state": "collapsed",
      "load_fixture": "collapsed_fixture",
      "assert": {
        "event": "ActiveChanged"
      }
    },
    {
      "id": "keyboard-02",
      "dispatch": {
        "key": "ArrowRight",
        "modifiers": []
      },
      "precondition": "active node has children",
      "expected_behavior": "Request expansion of the active branch.",
      "initial_state": "collapsed",
      "load_fixture": "collapsed_fixture",
      "assert": {
        "event": "ExpansionChanged"
      }
    }
  ],
  "accessibility_cases": [
    {
      "id": "a11y-collapsed",
      "state": "collapsed",
      "load_fixture": "collapsed_fixture",
      "expected_semantics": {
        "role": "tree",
        "properties": [
          {
            "name": "accessible-name",
            "value": "component label"
          },
          {
            "name": "items",
            "value": "each visible treeitem has its node label as accessible name and its one-based level"
          },
          {
            "name": "expanded",
            "value": "expandable treeitems expose expanded state"
          }
        ]
      },
      "capture": "mkit_harness::AccessibilitySnapshot::capture",
      "requires_active_platform_a11y": true,
      "headless_inactive_result": "unsupported_pending"
    },
    {
      "id": "a11y-expanded",
      "state": "expanded",
      "load_fixture": "expanded_fixture",
      "expected_semantics": {
        "role": "tree",
        "properties": [
          {
            "name": "accessible-name",
            "value": "component label"
          },
          {
            "name": "items",
