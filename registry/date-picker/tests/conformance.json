{
  "manifest_version": 1,
  "component": "date-picker",
  "source_spec_version": 1,
  "adapter_contract": {
    "fixture": "Provide each declared state fixture; load the initial_state fixture before dispatch.",
    "keyboard": "Dispatch the key with modifiers, then assert every field in the case's assert mapping.",
    "accessibility": "Capture the actual platform accessibility tree and compare declared semantics.",
    "screenshots": "Render each state/theme/scale case and compare its named baseline.",
    "custom_tests": null
  },
  "keyboard_cases": [
    {
      "id": "keyboard-01",
      "dispatch": {
        "key": "ArrowDown",
        "modifiers": [
          "Alt"
        ]
      },
      "precondition": "Date input is focused.",
      "expected_behavior": "Open the calendar and focus its active date cell.",
      "initial_state": "closed_value",
      "load_fixture": "closed_value_fixture",
      "assert": {
        "state": "open_single",
        "event": "OpenChanged"
      }
    },
    {
      "id": "keyboard-02",
      "dispatch": {
        "key": "Enter",
        "modifiers": []
      },
      "precondition": "Input text parses and is valid, or a calendar date is active.",
      "expected_behavior": "Commit the parsed input date or active calendar date and close the calendar.",
      "initial_state": "editing_valid",
      "load_fixture": "editing_valid_fixture",
      "assert": {
        "event": "ChangeRequested"
      }
    },
    {
      "id": "keyboard-03",
      "dispatch": {
        "key": "Escape",
        "modifiers": []
      },
      "precondition": "Calendar is open or the input contains an uncommitted draft.",
      "expected_behavior": "Close the calendar, restore the prior committed text and selection, and clear validation.",
      "initial_state": "editing_invalid",
      "load_fixture": "editing_invalid_fixture",
      "assert": {
        "event": "Cancelled"
      }
    },
    {
      "id": "keyboard-04",
      "dispatch": {
        "key": "Tab",
        "modifiers": []
      },
      "precondition": "Calendar is open.",
      "expected_behavior": "Close the calendar and continue normal forward focus traversal without committing a draft.",
      "initial_state": "open_single",
      "load_fixture": "open_single_fixture",
      "assert": {
        "state": "closed_value",
        "focus_target": "next"
      }
    },
    {
      "id": "keyboard-05",
      "dispatch": {
        "key": "Tab",
        "modifiers": [
          "Shift"
        ]
      },
      "precondition": "Calendar is open.",
      "expected_behavior": "Close the calendar and continue normal backward focus traversal without committing a draft.",
      "initial_state": "open_single",
      "load_fixture": "open_single_fixture",
      "assert": {
        "state": "closed_value",
        "focus_target": "previous"
      }
    }
  ],
  "accessibility_cases": [
