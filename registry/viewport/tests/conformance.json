{
  "manifest_version": 1,
  "component": "viewport",
  "source_spec_version": 1,
  "adapter_contract": {
    "fixture": "Provide each declared state fixture; load the initial_state fixture before dispatch.",
    "keyboard": "Dispatch the key with modifiers, then assert every field in the case's assert mapping.",
    "accessibility": "Capture the actual platform accessibility tree and compare declared semantics.",
    "screenshots": "Render each state/theme/scale case and compare its named baseline.",
    "custom_tests": null
  },
  "keyboard_cases": [
    {
      "id": "keyboard-01",
      "dispatch": {
        "key": "ArrowRight",
        "modifiers": []
      },
      "precondition": "Viewport has focus.",
      "expected_behavior": "Pan content left by one theme spacing step so the view moves right.",
      "initial_state": "actual-size",
      "load_fixture": "viewport_actual_size",
      "assert": {
        "state": "panned",
        "event": "transform_changed"
      }
    },
    {
      "id": "keyboard-02",
      "dispatch": {
        "key": "ArrowLeft",
        "modifiers": []
      },
      "precondition": "Viewport has focus.",
      "expected_behavior": "Pan content right by one theme spacing step.",
      "initial_state": "actual-size",
      "load_fixture": "viewport_actual_size",
      "assert": {
        "state": "panned",
        "event": "transform_changed"
      }
    },
    {
      "id": "keyboard-03",
      "dispatch": {
        "key": "ArrowUp",
        "modifiers": []
      },
      "precondition": "Viewport has focus.",
      "expected_behavior": "Pan content down by one theme spacing step.",
      "initial_state": "actual-size",
      "load_fixture": "viewport_actual_size",
      "assert": {
        "state": "panned",
        "event": "transform_changed"
      }
    },
    {
      "id": "keyboard-04",
      "dispatch": {
        "key": "ArrowDown",
        "modifiers": []
      },
      "precondition": "Viewport has focus.",
      "expected_behavior": "Pan content up by one theme spacing step.",
      "initial_state": "actual-size",
      "load_fixture": "viewport_actual_size",
      "assert": {
        "state": "panned",
        "event": "transform_changed"
      }
    },
    {
      "id": "keyboard-05",
      "dispatch": {
        "key": "Equal",
        "modifiers": []
      },
      "precondition": "Viewport has focus.",
      "expected_behavior": "Zoom in around the viewport center.",
      "initial_state": "actual-size",
      "load_fixture": "viewport_actual_size",
      "assert": {
        "state": "zoomed",
        "event": "transform_changed"
      }
    },
    {
      "id": "keyboard-06",
      "dispatch": {
        "key": "Minus",
        "modifiers": []
      },
      "precondition": "Viewport has focus.",
      "expected_behavior": "Zoom out around the viewport center.",
      "initial_state": "actual-size",
      "load_fixture": "viewport_actual_size",
      "assert": {
        "state": "zoomed",
        "event": "transform_changed"
      }
    },
    {
      "id": "keyboard-07",
      "dispatch": {
        "key": "F",
        "modifiers": []
      },
      "precondition": "Viewport has focus and content has a positive extent.",
      "expected_behavior": "Fit all content with theme-token padding.",
      "initial_state": "actual-size",
      "load_fixture": "viewport_actual_size",
      "assert": {
        "state": "fitted",
        "event": "transform_changed"
      }
    },
    {
      "id": "keyboard-08",
      "dispatch": {
        "key": "1",
        "modifiers": []
      },
      "precondition": "Viewport has focus.",
      "expected_behavior": "Show content at 100 percent, centered.",
      "initial_state": "zoomed",
      "load_fixture": "viewport_zoomed",
      "assert": {
        "state": "actual-size",
        "event": "transform_changed"
      }
    }
  ],
  "accessibility_cases": [
    {
      "id": "a11y-actual-size",
      "state": "actual-size",
      "load_fixture": "viewport_actual_size",
      "expected_semantics": {
        "role": "group",
        "properties": [
          {
            "name": "name",
            "value": "Canvas viewport"
          },
          {
            "name": "description",
            "value": "Arrow keys pan; plus and minus zoom; F fits; 1 shows actual size."
          }
        ]
      },
      "capture": "mkit_harness::AccessibilitySnapshot::capture",
      "requires_active_platform_a11y": true,
      "headless_inactive_result": "unsupported_pending"
    },
    {
