{
  "manifest_version": 1,
  "component": "status-bar",
  "source_spec_version": 1,
  "adapter_contract": {
    "fixture": "Provide each declared state fixture; load the initial_state fixture before dispatch.",
    "keyboard": "Dispatch the key with modifiers, then assert every field in the case's assert mapping.",
    "accessibility": "Capture the actual platform accessibility tree and compare declared semantics.",
    "screenshots": "Render each state/theme/scale case and compare its named baseline.",
    "custom_tests": null
  },
  "keyboard_cases": [
    {
      "id": "keyboard-01",
      "dispatch": {
        "key": "Enter",
        "modifiers": []
      },
      "precondition": "A supplied enabled button in the status bar is focused.",
      "expected_behavior": "Activate the supplied button using its normal GPUI behavior.",
      "initial_state": "full",
      "load_fixture": "full_fixture",
      "assert": {
        "focus_target": "same_button"
      }
    },
    {
      "id": "keyboard-02",
      "dispatch": {
        "key": "Space",
        "modifiers": []
      },
      "precondition": "A supplied enabled button in the status bar is focused.",
      "expected_behavior": "Activate the supplied button using its normal GPUI behavior.",
      "initial_state": "full",
      "load_fixture": "full_fixture",
      "assert": {
        "focus_target": "same_button"
      }
    }
  ],
  "accessibility_cases": [
    {
      "id": "a11y-full",
      "state": "full",
      "load_fixture": "full_fixture",
      "expected_semantics": {
        "role": "group",
        "properties": [
          {
            "name": "name",
            "value": "caller-provided status bar label"
          },
          {
            "name": "status_role",
            "value": "status"
          },
          {
            "name": "live",
            "value": "polite"
          },
          {
            "name": "role",
            "value": "progress_indicator"
          }
        ]
      },
      "capture": "mkit_harness::AccessibilitySnapshot::capture",
      "requires_active_platform_a11y": true,
      "headless_inactive_result": "unsupported_pending"
    },
