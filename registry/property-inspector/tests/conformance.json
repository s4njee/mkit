{
  "manifest_version": 1,
  "component": "property-inspector",
  "source_spec_version": 1,
  "adapter_contract": {
    "fixture": "Provide each declared state fixture; load the initial_state fixture before dispatch.",
    "keyboard": "Dispatch the key with modifiers, then assert every field in the case's assert mapping.",
    "accessibility": "Capture the actual platform accessibility tree and compare declared semantics.",
    "screenshots": "Render each state/theme/scale case and compare its named baseline.",
    "custom_tests": null
  },
  "keyboard_cases": [
    {
      "id": "keyboard-01",
      "dispatch": {
        "key": "ArrowDown",
        "modifiers": []
      },
      "precondition": "Inspector is focused and a property row is active.",
      "expected_behavior": "Move active property to the next visible enabled row, skipping collapsed groups and wrapping.",
      "initial_state": "expanded",
      "load_fixture": "expanded_fixture",
      "assert": {
        "state": "expanded",
        "focus_target": "next_property"
      }
    },
    {
      "id": "keyboard-02",
      "dispatch": {
        "key": "ArrowUp",
        "modifiers": []
      },
      "precondition": "Inspector is focused and a property row is active.",
      "expected_behavior": "Move active property to the previous visible enabled row, skipping collapsed groups and wrapping.",
      "initial_state": "expanded",
      "load_fixture": "expanded_fixture",
      "assert": {
        "state": "expanded",
        "focus_target": "previous_property"
      }
    },
    {
      "id": "keyboard-03",
      "dispatch": {
        "key": "Space",
        "modifiers": []
      },
      "precondition": "A boolean property row is active.",
      "expected_behavior": "Request the opposite boolean value.",
      "initial_state": "expanded",
      "load_fixture": "expanded_fixture",
      "assert": {
        "event": "value_changed"
      }
    },
    {
      "id": "keyboard-04",
      "dispatch": {
        "key": "r",
        "modifiers": []
      },
      "precondition": "A property row is active and has a default value.",
      "expected_behavior": "Request its default value.",
      "initial_state": "expanded",
      "load_fixture": "expanded_fixture",
      "assert": {
        "event": "value_changed"
      }
    }
  ],
  "accessibility_cases": [
    {
      "id": "a11y-expanded",
      "state": "expanded",
      "load_fixture": "expanded_fixture",
      "expected_semantics": {
        "role": "group",
        "properties": [
          {
            "name": "name",
            "value": "Property inspector"
          },
          {
            "name": "row-role",
            "value": "named group"
          },
          {
            "name": "mixed-value",
            "value": "represented by a mixed label and empty editor value"
          },
          {
            "name": "collapsed",
            "value": "Group header exposes expanded=false and descendants are omitted."
          },
          {
            "name": "focus",
            "value": "Disabled controls are not keyboard tabbable; ArrowUp/Down updates the active enabled visible property and wraps."
          }
        ]
      },
      "capture": "mkit_harness::AccessibilitySnapshot::capture",
      "requires_active_platform_a11y": true,
      "headless_inactive_result": "unsupported_pending"
    },
