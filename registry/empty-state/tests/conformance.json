    {
      "id": "a11y-basic",
      "state": "basic",
      "load_fixture": "basic_fixture",
      "expected_semantics": {
        "role": "group",
        "properties": [
          {
            "name": "label",
            "value": "title"
          },
          {
            "name": "description",
            "value": "optional explanatory text"
          },
          {
            "name": "actions",
            "value": "caller-provided controls, in insertion order"
          }
        ]
      },
      "capture": "mkit_harness::AccessibilitySnapshot::capture",
      "requires_active_platform_a11y": true,
      "headless_inactive_result": "unsupported_pending"
    },
