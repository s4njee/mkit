{
  "manifest_version": 1,
  "component": "text-area",
  "source_spec_version": 1,
  "adapter_contract": {
    "fixture": "Provide each declared state fixture; load the initial_state fixture before dispatch.",
    "keyboard": "Dispatch the key with modifiers, then assert every field in the case's assert mapping.",
    "accessibility": "Capture the actual platform accessibility tree and compare declared semantics.",
    "screenshots": "Render each state/theme/scale case and compare its named baseline.",
    "custom_tests": null
  },
  "keyboard_cases": [
    {
      "id": "keyboard-01",
      "dispatch": {
        "key": "Ctrl+A",
        "modifiers": [
          "Ctrl"
        ]
      },
      "precondition": "focused",
      "expected_behavior": "Select all text using the platform text-editing command.",
      "initial_state": "filled",
      "load_fixture": "filled_fixture",
      "assert": {
        "state": "focused",
        "focus_target": "input"
      }
    },
    {
      "id": "keyboard-02",
      "dispatch": {
        "key": "Ctrl+Z",
        "modifiers": [
          "Ctrl"
        ]
      },
      "precondition": "focused and not composing",
      "expected_behavior": "Undo the latest edit when the fixture has undo history.",
      "initial_state": "filled",
      "load_fixture": "filled_fixture",
      "assert": {
        "state": "filled",
        "event": "input",
        "focus_target": "input"
      }
    },
    {
      "id": "keyboard-03",
      "dispatch": {
        "key": "Ctrl+Shift+Z",
        "modifiers": [
          "Ctrl",
          "Shift"
        ]
      },
      "precondition": "focused and not composing",
      "expected_behavior": "Redo the latest undone edit when the fixture has redo history.",
      "initial_state": "filled",
      "load_fixture": "filled_fixture",
      "assert": {
        "state": "filled",
        "event": "input",
        "focus_target": "input"
      }
    },
    {
      "id": "keyboard-04",
      "dispatch": {
        "key": "Ctrl+C",
        "modifiers": [
          "Ctrl"
        ]
      },
      "precondition": "focused and enabled and selection is non-empty",
      "expected_behavior": "Copy the selected UTF-8 text to the GPUI system clipboard without changing the value.",
      "initial_state": "selected",
      "load_fixture": "selected_fixture",
      "assert": {
        "state": "selected",
        "event": "none",
        "focus_target": "input"
      }
    },
    {
      "id": "keyboard-05",
      "dispatch": {
        "key": "Ctrl+X",
        "modifiers": [
          "Ctrl"
        ]
      },
      "precondition": "focused and enabled and selection is non-empty",
      "expected_behavior": "Copy the selection then remove it and emit the resulting input snapshot.",
      "initial_state": "selected",
      "load_fixture": "selected_fixture",
      "assert": {
        "state": "filled",
        "event": "input",
        "focus_target": "input"
      }
    },
    {
      "id": "keyboard-06",
      "dispatch": {
        "key": "Ctrl+V",
        "modifiers": [
          "Ctrl"
        ]
      },
      "precondition": "focused and enabled and clipboard contains text",
      "expected_behavior": "Replace the selection/caret with clipboard text and emit the resulting input snapshot.",
      "initial_state": "focused",
      "load_fixture": "focused_fixture",
      "assert": {
        "state": "filled",
        "event": "input",
        "focus_target": "input"
      }
    },
    {
      "id": "keyboard-07",
      "dispatch": {
        "key": "Enter",
        "modifiers": []
      },
      "precondition": "focused",
      "expected_behavior": "Insert a newline at the selection/caret; Enter does not submit a form.",
      "initial_state": "focused",
      "load_fixture": "focused_fixture",
      "assert": {
        "state": "filled",
        "event": "input",
        "focus_target": "input"
      }
    },
    {
      "id": "keyboard-08",
      "dispatch": {
        "key": "Ctrl+A",
        "modifiers": [
          "Ctrl"
        ]
      },
      "precondition": "disabled",
      "expected_behavior": "Do not change selection or emit an event.",
      "initial_state": "disabled",
      "load_fixture": "disabled_fixture",
      "assert": {
        "state": "disabled",
        "event": "none",
        "focus_target": "none"
      }
    }
  ],
  "accessibility_cases": [
    {
      "id": "a11y-empty",
      "state": "empty",
      "load_fixture": "empty_fixture",
      "expected_semantics": {
        "role": "textbox",
        "properties": [
          {
            "name": "aria-multiline",
            "value": true
          },
          {
            "name": "aria-value",
            "value": "current editor text"
          }
        ]
      },
      "capture": "mkit_harness::AccessibilitySnapshot::capture",
      "requires_active_platform_a11y": true,
