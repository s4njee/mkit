{
  "manifest_version": 1,
  "component": "checkbox",
  "source_spec_version": 1,
  "adapter_contract": {
    "fixture": "Provide each declared state fixture; load the initial_state fixture before dispatch.",
    "keyboard": "Dispatch the key with modifiers, then assert every field in the case's assert mapping.",
    "accessibility": "Capture the actual platform accessibility tree and compare declared semantics.",
    "screenshots": "Render each state/theme/scale case and compare its named baseline.",
    "custom_tests": null
  },
  "keyboard_cases": [
    {
      "id": "keyboard-01",
      "dispatch": {
        "key": "Space",
        "modifiers": []
      },
      "precondition": "Checkbox has focus and is enabled.",
      "expected_behavior": "Toggle checked state.",
      "initial_state": "unchecked",
      "load_fixture": "unchecked_fixture",
      "assert": {
        "state": "checked",
        "event": "change"
      }
    }
  ],
  "accessibility_cases": [
    {
      "id": "a11y-unchecked",
      "state": "unchecked",
      "load_fixture": "unchecked_fixture",
      "expected_semantics": {
        "role": "checkbox",
        "properties": [
          {
            "name": "aria-checked",
            "value": false
          }
        ]
      },
      "capture": "mkit_harness::AccessibilitySnapshot::capture",
      "requires_active_platform_a11y": true,
      "headless_inactive_result": "unsupported_pending"
    },
    {
      "id": "a11y-checked",
      "state": "checked",
      "load_fixture": "checked_fixture",
      "expected_semantics": {
        "role": "checkbox",
        "properties": [
          {
            "name": "aria-checked",
            "value": true
          }
        ]
      },
      "capture": "mkit_harness::AccessibilitySnapshot::capture",
      "requires_active_platform_a11y": true,
      "headless_inactive_result": "unsupported_pending"
    },
    {
      "id": "a11y-indeterminate",
      "state": "indeterminate",
      "load_fixture": "indeterminate_fixture",
      "expected_semantics": {
        "role": "checkbox",
        "properties": [
          {
            "name": "aria-checked",
            "value": "mixed"
          }
        ]
      },
      "capture": "mkit_harness::AccessibilitySnapshot::capture",
      "requires_active_platform_a11y": true,
      "headless_inactive_result": "unsupported_pending"
    },
    {
      "id": "a11y-disabled",
      "state": "disabled",
      "load_fixture": "disabled_fixture",
      "expected_semantics": {
        "role": "checkbox",
        "properties": [
          {
            "name": "aria-disabled",
            "value": true
          },
          {
            "name": "description",
            "value": "Unavailable"
          }
        ]
      },
      "capture": "mkit_harness::AccessibilitySnapshot::capture",
      "requires_active_platform_a11y": true,
      "headless_inactive_result": "unsupported_pending"
    }
  ],
