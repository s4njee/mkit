{
  "manifest_version": 1,
  "component": "switch",
  "source_spec_version": 1,
  "adapter_contract": {
    "fixture": "Provide each declared state fixture; load the initial_state fixture before dispatch.",
    "keyboard": "Dispatch the key with modifiers, then assert every field in the case's assert mapping.",
    "accessibility": "Capture the actual platform accessibility tree and compare declared semantics.",
    "screenshots": "Render each state/theme/scale case and compare its named baseline.",
    "custom_tests": null
  },
  "keyboard_cases": [
    {
      "id": "keyboard-01",
      "dispatch": {
        "key": "Space",
        "modifiers": []
      },
      "precondition": "Enabled switch has focus.",
      "expected_behavior": "Toggle switch value.",
      "initial_state": "off",
      "load_fixture": "off_fixture",
      "assert": {
        "state": "on",
        "event": "change"
      }
    }
  ],
  "accessibility_cases": [
    {
      "id": "a11y-off",
      "state": "off",
      "load_fixture": "off_fixture",
      "expected_semantics": {
        "role": "switch",
        "properties": [
          {
            "name": "aria-checked",
            "value": false
          }
        ]
      },
      "capture": "mkit_harness::AccessibilitySnapshot::capture",
      "requires_active_platform_a11y": true,
      "headless_inactive_result": "unsupported_pending"
    },
    {
      "id": "a11y-on",
      "state": "on",
      "load_fixture": "on_fixture",
      "expected_semantics": {
        "role": "switch",
        "properties": [
          {
            "name": "aria-checked",
            "value": true
          }
        ]
      },
      "capture": "mkit_harness::AccessibilitySnapshot::capture",
      "requires_active_platform_a11y": true,
      "headless_inactive_result": "unsupported_pending"
    },
    {
      "id": "a11y-disabled",
      "state": "disabled",
      "load_fixture": "disabled_fixture",
      "expected_semantics": {
        "role": "switch",
        "properties": [
          {
            "name": "aria-checked",
            "value": false
          },
          {
            "name": "aria-disabled",
            "value": true
          },
          {
            "name": "aria-description",
            "value": "Unavailable"
          }
        ]
      },
      "capture": "mkit_harness::AccessibilitySnapshot::capture",
      "requires_active_platform_a11y": true,
      "headless_inactive_result": "unsupported_pending"
    }
  ],
