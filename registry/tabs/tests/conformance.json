{
  "manifest_version": 1,
  "component": "tabs",
  "source_spec_version": 1,
  "adapter_contract": {
    "fixture": "Provide each declared state fixture; load the initial_state fixture before dispatch.",
    "keyboard": "Dispatch the key with modifiers, then assert every field in the case's assert mapping.",
    "accessibility": "Capture the actual platform accessibility tree and compare declared semantics.",
    "screenshots": "Render each state/theme/scale case and compare its named baseline.",
    "custom_tests": null
  },
  "keyboard_cases": [
    {
      "id": "keyboard-01",
      "dispatch": {
        "key": "ArrowRight",
        "modifiers": []
      },
      "precondition": "a tab is focused in horizontal orientation",
      "expected_behavior": "Move focus to the next enabled tab with wrapping without changing selection.",
      "initial_state": "selection",
      "load_fixture": "tabs_selection",
      "assert": {
        "state": "selection",
        "focus_target": "three",
        "event": "none"
      }
    },
    {
      "id": "keyboard-02",
      "dispatch": {
        "key": "ArrowLeft",
        "modifiers": []
      },
      "precondition": "a tab is focused in horizontal orientation",
      "expected_behavior": "Move focus to the previous enabled tab with wrapping without changing selection.",
      "initial_state": "selection",
      "load_fixture": "tabs_selection",
      "assert": {
        "state": "selection",
        "focus_target": "three",
        "event": "none"
      }
    },
    {
      "id": "keyboard-03",
      "dispatch": {
        "key": "Home",
        "modifiers": []
      },
      "precondition": "a tab is focused",
      "expected_behavior": "Move focus to the first enabled tab without changing selection.",
      "initial_state": "selection",
      "load_fixture": "tabs_selection",
      "assert": {
        "state": "selection",
        "focus_target": "one",
        "event": "none"
      }
    },
    {
      "id": "keyboard-04",
      "dispatch": {
        "key": "End",
        "modifiers": []
      },
      "precondition": "a tab is focused",
      "expected_behavior": "Move focus to the last enabled tab without changing selection.",
      "initial_state": "selection",
      "load_fixture": "tabs_selection",
      "assert": {
        "state": "selection",
        "focus_target": "three",
        "event": "none"
      }
    },
    {
      "id": "keyboard-05",
      "dispatch": {
        "key": "Enter",
        "modifiers": []
      },
      "precondition": "the third tab is focused and the first tab is selected",
      "expected_behavior": "Select the focused tab.",
      "initial_state": "focus_pending",
      "load_fixture": "tabs_focus_pending",
      "assert": {
        "state": "selected_three",
        "focus_target": "three",
        "event": "selection_changed"
      }
    },
    {
      "id": "keyboard-06",
      "dispatch": {
        "key": "Space",
        "modifiers": []
      },
      "precondition": "the third tab is focused and the first tab is selected",
      "expected_behavior": "Select the focused tab.",
      "initial_state": "focus_pending",
      "load_fixture": "tabs_focus_pending",
      "assert": {
        "state": "selected_three",
        "focus_target": "three",
        "event": "selection_changed"
      }
    },
    {
      "id": "keyboard-07",
      "dispatch": {
        "key": "ArrowRight",
        "modifiers": []
      },
      "precondition": "the tablist is disabled",
      "expected_behavior": "Keep focus and selection unchanged without emitting an event.",
      "initial_state": "disabled",
      "load_fixture": "tabs_disabled",
      "assert": {
        "state": "disabled",
        "focus_target": "none",
        "event": "none"
      }
    },
    {
      "id": "keyboard-08",
      "dispatch": {
        "key": "ArrowRight",
        "modifiers": []
      },
      "precondition": "a controlled tablist has the first tab selected",
      "expected_behavior": "Move focus without changing controlled selection.",
      "initial_state": "controlled",
      "load_fixture": "tabs_controlled",
      "assert": {
        "state": "controlled",
        "focus_target": "three",
        "event": "none"
      }
    },
    {
      "id": "keyboard-09",
      "dispatch": {
        "key": "ArrowDown",
        "modifiers": []
      },
      "precondition": "a tab is focused in vertical orientation",
      "expected_behavior": "Move focus to the next enabled tab with wrapping without changing selection.",
      "initial_state": "vertical",
      "load_fixture": "tabs_vertical",
      "assert": {
        "state": "vertical",
        "focus_target": "three",
        "event": "none"
      }
    }
  ],
  "accessibility_cases": [
    {
      "id": "a11y-selection",
      "state": "selection",
      "load_fixture": "tabs_selection",
      "expected_semantics": {
        "role": "tablist",
        "properties": [
          {
            "name": "label",
            "value": "Views"
          },
          {
            "name": "orientation",
            "value": "horizontal by default; vertical when configured"
          }
        ]
      },
      "capture": "mkit_harness::AccessibilitySnapshot::capture",
      "requires_active_platform_a11y": true,
      "headless_inactive_result": "unsupported_pending"
    },
