{
  "manifest_version": 1,
  "component": "time-field",
  "source_spec_version": 1,
  "adapter_contract": {
    "fixture": "Provide each declared state fixture; load the initial_state fixture before dispatch.",
    "keyboard": "Dispatch the key with modifiers, then assert every field in the case's assert mapping.",
    "accessibility": "Capture the actual platform accessibility tree and compare declared semantics.",
    "screenshots": "Render each state/theme/scale case and compare its named baseline.",
    "custom_tests": null
  },
  "keyboard_cases": [
    {
      "id": "keyboard-01",
      "dispatch": {
        "key": "ArrowUp",
        "modifiers": []
      },
      "precondition": "An enabled segment is focused.",
      "expected_behavior": "Increment the focused segment by its step and commit a valid value.",
      "initial_state": "focused_minute",
      "load_fixture": "focused_minute_fixture",
      "assert": {
        "event": "TimeChanged"
      }
    },
    {
      "id": "keyboard-02",
      "dispatch": {
        "key": "ArrowDown",
        "modifiers": []
      },
      "precondition": "An enabled segment is focused.",
      "expected_behavior": "Decrement the focused segment by its step and commit a valid value.",
      "initial_state": "focused_minute",
      "load_fixture": "focused_minute_fixture",
      "assert": {
        "event": "TimeChanged"
      }
    },
    {
      "id": "keyboard-03",
      "dispatch": {
        "key": "ArrowRight",
        "modifiers": []
      },
      "precondition": "An enabled segment is focused.",
      "expected_behavior": "Move focus to the next available segment.",
      "initial_state": "focused_hour",
      "load_fixture": "focused_hour_fixture",
      "assert": {
        "focus_target": "minute"
      }
    },
    {
      "id": "keyboard-04",
      "dispatch": {
        "key": "ArrowLeft",
        "modifiers": []
      },
      "precondition": "An enabled segment is focused.",
      "expected_behavior": "Move focus to the previous available segment.",
      "initial_state": "focused_minute",
      "load_fixture": "focused_minute_fixture",
      "assert": {
        "focus_target": "hour"
      }
    },
    {
      "id": "keyboard-05",
      "dispatch": {
        "key": "0-9",
        "modifiers": []
      },
      "precondition": "An enabled numeric segment is focused.",
      "expected_behavior": "Replace the segment draft; commit after a complete valid segment value.",
      "initial_state": "focused_hour",
      "load_fixture": "focused_hour_fixture",
      "assert": {
        "event": "TimeChanged"
      }
    },
    {
      "id": "keyboard-06",
      "dispatch": {
        "key": "Enter",
        "modifiers": []
      },
      "precondition": "An enabled segment has a valid draft.",
      "expected_behavior": "Commit the composed time value.",
      "initial_state": "focused_minute",
      "load_fixture": "focused_minute_fixture",
      "assert": {
        "event": "TimeChanged"
      }
    }
  ],
