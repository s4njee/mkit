{
  "manifest_version": 1,
  "component": "stepper",
  "source_spec_version": 1,
  "adapter_contract": {
    "fixture": "Provide each declared state fixture; load the initial_state fixture before dispatch.",
    "keyboard": "Dispatch the key with modifiers, then assert every field in the case's assert mapping.",
    "accessibility": "Capture the actual platform accessibility tree and compare declared semantics.",
    "screenshots": "Render each state/theme/scale case and compare its named baseline.",
    "custom_tests": null
  },
  "keyboard_cases": [
    {
      "id": "keyboard-01",
      "dispatch": {
        "key": "Enter",
        "modifiers": []
      },
      "precondition": "The enabled Next, Back, or Finish button is focused.",
      "expected_behavior": "Activate the focused step navigation action.",
      "initial_state": "middle",
      "load_fixture": "middle_fixture",
      "assert": {
        "event": "step_change_requested",
        "focus_target": "same_button"
      }
    },
    {
      "id": "keyboard-02",
      "dispatch": {
        "key": "Space",
        "modifiers": []
      },
      "precondition": "The enabled Next, Back, or Finish button is focused.",
      "expected_behavior": "Activate the focused step navigation action.",
      "initial_state": "middle",
      "load_fixture": "middle_fixture",
      "assert": {
        "event": "step_change_requested",
        "focus_target": "same_button"
      }
    }
  ],
  "accessibility_cases": [
    {
      "id": "a11y-first",
      "state": "first",
      "load_fixture": "first_fixture",
      "expected_semantics": {
        "role": "group",
        "properties": [
          {
            "name": "name",
            "value": "caller-provided flow label"
          },
          {
            "name": "current",
            "value": "current step label"
          },
          {
            "name": "position",
            "value": "current step index and total count"
          }
        ]
      },
      "capture": "mkit_harness::AccessibilitySnapshot::capture",
      "requires_active_platform_a11y": true,
      "headless_inactive_result": "unsupported_pending"
    },
    {
      "id": "a11y-middle",
      "state": "middle",
      "load_fixture": "middle_fixture",
      "expected_semantics": {
