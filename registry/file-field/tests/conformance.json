  "adapter_contract": {
    "fixture": "Provide each declared state fixture; load the initial_state fixture before dispatch.",
    "keyboard": "Dispatch the key with modifiers, then assert every field in the case's assert mapping.",
    "accessibility": "Capture the actual platform accessibility tree and compare declared semantics.",
    "screenshots": "Render each state/theme/scale case and compare its named baseline.",
    "custom_tests": null
  },
  "keyboard_cases": [
    {
      "id": "keyboard-01",
      "dispatch": {
        "key": "Enter",
        "modifiers": []
      },
      "precondition": "The Browse button is focused and enabled.",
      "expected_behavior": "Open the platform file picker.",
      "initial_state": "empty",
      "load_fixture": "empty_fixture",
      "assert": {
        "event": "browse_requested",
        "focus_target": "same_button"
      }
    },
    {
      "id": "keyboard-02",
      "dispatch": {
        "key": "Space",
        "modifiers": []
      },
      "precondition": "The Browse button is focused and enabled.",
      "expected_behavior": "Open the platform file picker.",
      "initial_state": "empty",
      "load_fixture": "empty_fixture",
      "assert": {
        "event": "browse_requested",
        "focus_target": "same_button"
      }
    },
    {
      "id": "keyboard-03",
      "dispatch": {
        "key": "Enter",
        "modifiers": []
      },
      "precondition": "A focused Remove file button is enabled.",
      "expected_behavior": "Remove that file from the selection proposal.",
      "initial_state": "selected",
      "load_fixture": "selected_fixture",
      "assert": {
        "event": "files_change",
        "focus_target": "browse_or_next_remove"
      }
    },
    {
      "id": "keyboard-04",
      "dispatch": {
        "key": "Space",
        "modifiers": []
      },
