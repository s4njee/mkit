{
  "manifest_version": 1,
  "component": "search-field",
  "source_spec_version": 1,
  "adapter_contract": {
    "fixture": "Provide each declared state fixture; load the initial_state fixture before dispatch.",
    "keyboard": "Dispatch the key with modifiers, then assert every field in the case's assert mapping.",
    "accessibility": "Capture the actual platform accessibility tree and compare declared semantics.",
    "screenshots": "Render each state/theme/scale case and compare its named baseline.",
    "custom_tests": null
  },
  "keyboard_cases": [
    {
      "id": "keyboard-01",
      "dispatch": {
        "key": "Escape",
        "modifiers": []
      },
      "precondition": "Search field is focused and query is non-empty.",
      "expected_behavior": "Clear the query immediately and emit SearchChanged.",
      "initial_state": "query",
      "load_fixture": "query_fixture",
      "assert": {
        "state": "empty",
        "event": "SearchChanged"
      }
    },
    {
      "id": "keyboard-02",
      "dispatch": {
        "key": "cmd-f",
        "modifiers": []
      },
      "precondition": "Search field is mounted and enabled.",
      "expected_behavior": "Focus the search input.",
      "initial_state": "empty",
      "load_fixture": "empty_fixture",
      "assert": {
        "focus_target": "search-input"
      }
    },
    {
      "id": "keyboard-03",
      "dispatch": {
        "key": "Enter",
        "modifiers": []
      },
      "precondition": "Clear button is focused and enabled.",
      "expected_behavior": "Clear the query immediately and focus the search input.",
      "initial_state": "query",
      "load_fixture": "query_fixture",
      "assert": {
        "state": "empty",
        "event": "SearchChanged"
      }
    },
    {
      "id": "keyboard-04",
      "dispatch": {
        "key": "Space",
        "modifiers": []
      },
      "precondition": "Clear button is focused and enabled.",
      "expected_behavior": "Clear the query immediately and focus the search input.",
      "initial_state": "query",
      "load_fixture": "query_fixture",
      "assert": {
        "state": "empty",
        "event": "SearchChanged"
      }
    }
  ],
  "accessibility_cases": [
    {
      "id": "a11y-empty",
      "state": "empty",
      "load_fixture": "empty_fixture",
      "expected_semantics": {
        "role": "group",
        "properties": [
          {
            "name": "label",
            "value": "Search"
          },
          {
            "name": "input_role",
            "value": "text input"
          },
          {
            "name": "input_label",
            "value": "Search"
          },
          {
            "name": "clear_button",
            "value": "named button for enabled non-empty queries, otherwise omitted"
          },
          {
            "name": "result_count",
            "value": "polite status text when provided"
          }
        ]
      },
      "capture": "mkit_harness::AccessibilitySnapshot::capture",
      "requires_active_platform_a11y": true,
      "headless_inactive_result": "unsupported_pending"
    },
