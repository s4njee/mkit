{
  "manifest_version": 1,
  "component": "scrubbable-number-field",
  "source_spec_version": 1,
  "adapter_contract": {
    "fixture": "Provide each declared state fixture; load the initial_state fixture before dispatch.",
    "keyboard": "Dispatch the key with modifiers, then assert every field in the case's assert mapping.",
    "accessibility": "Capture the actual platform accessibility tree and compare declared semantics.",
    "screenshots": "Render each state/theme/scale case and compare its named baseline.",
    "custom_tests": null
  },
  "keyboard_cases": [
    {
      "id": "keyboard-01",
      "dispatch": {
        "key": "ArrowUp",
        "modifiers": []
      },
      "precondition": "focused, outside IME composition",
      "expected_behavior": "Increase by one step and commit the resulting value.",
      "initial_state": "focused",
      "load_fixture": "number_focused",
      "assert": {
        "state": "focused",
        "event": "value_changed",
        "focus_target": "number_field"
      }
    },
    {
      "id": "keyboard-02",
      "dispatch": {
        "key": "ArrowDown",
        "modifiers": []
      },
      "precondition": "focused, outside IME composition",
      "expected_behavior": "Decrease by one step and commit the resulting value.",
      "initial_state": "focused",
      "load_fixture": "number_focused",
      "assert": {
        "state": "focused",
        "event": "value_changed",
        "focus_target": "number_field"
      }
    },
    {
      "id": "keyboard-03",
      "dispatch": {
        "key": "PageUp",
        "modifiers": []
      },
      "precondition": "focused, outside IME composition",
      "expected_behavior": "Increase by the configured page step and commit the resulting value.",
      "initial_state": "focused",
      "load_fixture": "number_focused",
      "assert": {
        "state": "focused",
        "event": "value_changed",
        "focus_target": "number_field"
      }
    },
    {
      "id": "keyboard-04",
      "dispatch": {
        "key": "PageDown",
        "modifiers": []
      },
      "precondition": "focused, outside IME composition",
      "expected_behavior": "Decrease by the configured page step and commit the resulting value.",
      "initial_state": "focused",
      "load_fixture": "number_focused",
      "assert": {
        "state": "focused",
        "event": "value_changed",
        "focus_target": "number_field"
      }
    },
    {
      "id": "keyboard-05",
      "dispatch": {
        "key": "Home",
        "modifiers": []
      },
      "precondition": "focused, outside text editing or IME composition",
      "expected_behavior": "Set to the configured minimum when present; otherwise preserve platform text navigation.",
      "initial_state": "focused",
      "load_fixture": "number_focused",
      "assert": {
        "state": "focused",
        "event": "value_changed",
        "focus_target": "number_field"
      }
    },
    {
      "id": "keyboard-06",
      "dispatch": {
        "key": "End",
        "modifiers": []
      },
      "precondition": "focused, outside text editing or IME composition",
      "expected_behavior": "Set to the configured maximum when present; otherwise preserve platform text navigation.",
      "initial_state": "focused",
      "load_fixture": "number_focused",
      "assert": {
        "state": "focused",
        "event": "value_changed",
        "focus_target": "number_field"
      }
    },
    {
      "id": "keyboard-07",
      "dispatch": {
        "key": "Enter",
        "modifiers": []
      },
      "precondition": "editing",
      "expected_behavior": "Parse and commit a valid draft; restore the last committed value for an invalid draft.",
      "initial_state": "editing",
      "load_fixture": "number_editing",
      "assert": {
        "state": "focused",
        "event": "value_committed",
        "focus_target": "number_field"
      }
    },
    {
      "id": "keyboard-08",
      "dispatch": {
        "key": "Escape",
        "modifiers": []
      },
      "precondition": "editing",
      "expected_behavior": "Discard the uncommitted text draft and restore the last committed value.",
      "initial_state": "invalid_edit",
      "load_fixture": "number_invalid_edit",
      "assert": {
        "state": "focused",
        "focus_target": "number_field"
      }
    },
    {
      "id": "keyboard-09",
      "dispatch": {
        "key": "ArrowUp",
        "modifiers": [
          "Shift"
        ]
      },
      "precondition": "focused, outside IME composition",
      "expected_behavior": "Increase by one tenth of the configured step and commit.",
      "initial_state": "focused",
      "load_fixture": "number_focused",
      "assert": {
        "state": "focused",
        "event": "value_changed",
        "focus_target": "number_field"
      }
    },
    {
      "id": "keyboard-10",
      "dispatch": {
        "key": "ArrowDown",
        "modifiers": [
          "Shift"
        ]
      },
      "precondition": "focused, outside IME composition",
      "expected_behavior": "Decrease by one tenth of the configured step and commit.",
      "initial_state": "focused",
      "load_fixture": "number_focused",
      "assert": {
        "state": "focused",
        "event": "value_changed",
        "focus_target": "number_field"
      }
    }
  ],
  "accessibility_cases": [
    {
      "id": "a11y-idle",
      "state": "idle",
      "load_fixture": "number_idle",
      "expected_semantics": {
        "role": "spinbutton",
        "properties": [
          {
            "name": "value",
            "value": 12.5
          },
          {
            "name": "minimum",
            "value": 0
          },
          {
            "name": "maximum",
            "value": 100
          }
        ]
      },
      "capture": "mkit_harness::AccessibilitySnapshot::capture",
      "requires_active_platform_a11y": true,
      "headless_inactive_result": "unsupported_pending"
    },
