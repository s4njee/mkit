{
  "manifest_version": 1,
  "component": "dialog",
  "source_spec_version": 1,
  "adapter_contract": {
    "fixture": "Provide each declared state fixture; load the initial_state fixture before dispatch.",
    "keyboard": "Dispatch the key with modifiers, then assert every field in the case's assert mapping.",
    "accessibility": "Capture the actual platform accessibility tree and compare declared semantics.",
    "screenshots": "Render each state/theme/scale case and compare its named baseline.",
    "custom_tests": null
  },
  "keyboard_cases": [
    {
      "id": "keyboard-01",
      "dispatch": {
        "key": "Escape",
        "modifiers": []
      },
      "precondition": "surface is open and not busy",
      "expected_behavior": "Request dismissal.",
      "initial_state": "open",
      "load_fixture": "dialog_open",
      "assert": {
        "state": "closed",
        "event": "OpenChanged(false)"
      }
    },
    {
      "id": "keyboard-02",
      "dispatch": {
        "key": "Tab",
        "modifiers": []
      },
      "precondition": "surface is open",
      "expected_behavior": "Keep focus within the surface.",
      "initial_state": "open",
      "load_fixture": "dialog_open",
      "assert": {
        "focus_target": "surface"
      }
    },
    {
      "id": "keyboard-03",
      "dispatch": {
        "key": "Tab",
        "modifiers": [
          "Shift"
        ]
      },
      "precondition": "surface is open",
      "expected_behavior": "Keep focus within the surface.",
      "initial_state": "open",
      "load_fixture": "dialog_open",
      "assert": {
        "focus_target": "surface"
      }
    },
    {
      "id": "keyboard-04",
      "dispatch": {
        "key": "Tab",
        "modifiers": []
      },
      "precondition": "interactive surface is open with the first content control focused",
      "expected_behavior": "Move focus to the second content control.",
      "initial_state": "interactive",
      "load_fixture": "dialog_interactive",
      "assert": {
        "focus_target": "second_control"
      }
    },
    {
      "id": "keyboard-05",
      "dispatch": {
        "key": "Tab",
        "modifiers": [
          "Shift"
        ]
      },
      "precondition": "interactive surface is open with the first content control focused",
      "expected_behavior": "Wrap focus backward to the second content control.",
      "initial_state": "interactive",
      "load_fixture": "dialog_interactive",
      "assert": {
        "focus_target": "second_control"
      }
    }
  ],
  "accessibility_cases": [
    {
      "id": "a11y-closed",
      "state": "closed",
      "load_fixture": "dialog_closed",
      "expected_semantics": {
        "role": "dialog",
        "properties": []
      },
      "capture": "mkit_harness::AccessibilitySnapshot::capture",
      "requires_active_platform_a11y": true,
      "headless_inactive_result": "unsupported_pending"
    },
    {
      "id": "a11y-open",
      "state": "open",
      "load_fixture": "dialog_open",
      "expected_semantics": {
        "role": "dialog",
        "properties": [
          {
            "name": "aria-label",
            "value": "title"
          }
        ]
      },
      "capture": "mkit_harness::AccessibilitySnapshot::capture",
      "requires_active_platform_a11y": true,
      "headless_inactive_result": "unsupported_pending"
    },
    {
      "id": "a11y-busy",
      "state": "busy",
      "load_fixture": "dialog_busy",
      "expected_semantics": {
        "role": "dialog",
        "properties": [
          {
            "name": "aria-label",
            "value": "title"
          }
        ]
      },
      "capture": "mkit_harness::AccessibilitySnapshot::capture",
      "requires_active_platform_a11y": true,
      "headless_inactive_result": "unsupported_pending"
    },
    {
      "id": "a11y-interactive",
      "state": "interactive",
      "load_fixture": "dialog_interactive",
      "expected_semantics": {
        "role": "dialog",
        "properties": [
          {
            "name": "aria-label",
            "value": "title"
          }
        ]
      },
      "capture": "mkit_harness::AccessibilitySnapshot::capture",
      "requires_active_platform_a11y": true,
      "headless_inactive_result": "unsupported_pending"
    }
  ],
