{
  "manifest_version": 1,
  "component": "menu-bar",
  "source_spec_version": 1,
  "adapter_contract": {
    "fixture": "Provide each declared state fixture; load the initial_state fixture before dispatch.",
    "keyboard": "Dispatch the key with modifiers, then assert every field in the case's assert mapping.",
    "accessibility": "Capture the actual platform accessibility tree and compare declared semantics.",
    "screenshots": "Render each state/theme/scale case and compare its named baseline.",
    "custom_tests": null
  },
  "keyboard_cases": [
    {
      "id": "keyboard-01",
      "dispatch": {
        "key": "Alt",
        "modifiers": []
      },
      "precondition": "the window is active and the menu bar is enabled",
      "expected_behavior": "Focus the first enabled top-level menu without opening it.",
      "initial_state": "idle",
      "load_fixture": "menu_bar_idle",
      "assert": {
        "focus_target": "first-enabled-menu"
      }
    },
    {
      "id": "keyboard-02",
      "dispatch": {
        "key": "ArrowRight",
        "modifiers": []
      },
      "precondition": "the menu bar is focused or a menu is open",
      "expected_behavior": "Move to the next enabled top-level menu; if a popup is open, open its replacement.",
      "initial_state": "open",
      "load_fixture": "menu_bar_open",
      "assert": {
        "focus_target": "next-enabled-menu"
      }
    },
    {
      "id": "keyboard-03",
      "dispatch": {
        "key": "ArrowDown",
        "modifiers": []
      },
      "precondition": "a top-level menu is focused and closed",
      "expected_behavior": "Open its popup and activate the first enabled item.",
      "initial_state": "focused",
      "load_fixture": "menu_bar_focused",
      "assert": {
        "state": "open"
      }
    },
    {
      "id": "keyboard-04",
      "dispatch": {
        "key": "ArrowUp",
        "modifiers": []
      },
      "precondition": "a top-level menu is focused and closed",
      "expected_behavior": "Open its popup and activate the last enabled item.",
      "initial_state": "focused",
      "load_fixture": "menu_bar_focused",
      "assert": {
        "state": "open"
      }
    },
    {
      "id": "keyboard-05",
      "dispatch": {
        "key": "F",
        "modifiers": [
          "Alt"
        ]
      },
      "precondition": "an enabled top-level menu has the matching mnemonic",
      "expected_behavior": "Focus and open the matching menu.",
      "initial_state": "idle",
      "load_fixture": "menu_bar_idle",
      "assert": {
        "focus_target": "mnemonic-menu"
      }
    },
    {
      "id": "keyboard-06",
      "dispatch": {
        "key": "Escape",
        "modifiers": []
      },
      "precondition": "a popup is open",
      "expected_behavior": "Close the popup and return focus to its top-level menu header.",
      "initial_state": "open",
      "load_fixture": "menu_bar_open",
      "assert": {
        "focus_target": "active-menu-header"
      }
    },
    {
      "id": "keyboard-07",
      "dispatch": {
        "key": "Enter",
        "modifiers": []
      },
      "precondition": "a top-level menu header is focused",
      "expected_behavior": "Open its popup.",
      "initial_state": "focused",
      "load_fixture": "menu_bar_focused",
      "assert": {
        "state": "open"
      }
    }
  ],
  "accessibility_cases": [
    {
      "id": "a11y-idle",
      "state": "idle",
      "load_fixture": "menu_bar_idle",
      "expected_semantics": {
        "role": "menubar",
        "properties": [
          {
            "name": "top_level_menus",
            "value": "named menuitem elements with expanded state"
          }
        ]
      },
      "capture": "mkit_harness::AccessibilitySnapshot::capture",
      "requires_active_platform_a11y": true,
      "headless_inactive_result": "unsupported_pending"
    },
    {
      "id": "a11y-focused",
      "state": "focused",
      "load_fixture": "menu_bar_focused",
      "expected_semantics": {
        "role": "menubar",
        "properties": []
      },
      "capture": "mkit_harness::AccessibilitySnapshot::capture",
      "requires_active_platform_a11y": true,
      "headless_inactive_result": "unsupported_pending"
    },
    {
      "id": "a11y-open",
      "state": "open",
      "load_fixture": "menu_bar_open",
      "expected_semantics": {
        "role": "menubar",
        "properties": [
          {
            "name": "popup_items",
            "value": "menuitem, menuitemcheckbox, or menuitemradio according to model"
          }
        ]
      },
      "capture": "mkit_harness::AccessibilitySnapshot::capture",
      "requires_active_platform_a11y": true,
      "headless_inactive_result": "unsupported_pending"
    },
    {
      "id": "a11y-disabled",
      "state": "disabled",
      "load_fixture": "menu_bar_disabled",
      "expected_semantics": {
        "role": "menubar",
        "properties": [
          {
            "name": "disabled",
            "value": "unavailable headers and commands expose AccessKit disabled state"
          }
        ]
      },
      "capture": "mkit_harness::AccessibilitySnapshot::capture",
      "requires_active_platform_a11y": true,
      "headless_inactive_result": "unsupported_pending"
    }
  ],
