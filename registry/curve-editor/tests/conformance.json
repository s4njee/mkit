{
  "manifest_version": 1,
  "component": "curve-editor",
  "source_spec_version": 1,
  "adapter_contract": {
    "fixture": "Provide each declared state fixture; load the initial_state fixture before dispatch.",
    "keyboard": "Dispatch the key with modifiers, then assert every field in the case's assert mapping.",
    "accessibility": "Capture the actual platform accessibility tree and compare declared semantics.",
    "screenshots": "Render each state/theme/scale case and compare its named baseline.",
    "custom_tests": null
  },
  "keyboard_cases": [
    {
      "id": "keyboard-01",
      "dispatch": {
        "key": "ArrowRight",
        "modifiers": []
      },
      "precondition": "Curve editor is focused with a selected point.",
      "expected_behavior": "Nudge selected point right by 0.01 normalized units, preserving point order.",
      "initial_state": "selected-point",
      "load_fixture": "selected_point_fixture",
      "assert": {
        "event": "curve_changed"
      }
    },
    {
      "id": "keyboard-02",
      "dispatch": {
        "key": "ArrowUp",
        "modifiers": []
      },
      "precondition": "Curve editor is focused with a selected point.",
      "expected_behavior": "Nudge selected point up by 0.01 normalized units.",
      "initial_state": "selected-point",
      "load_fixture": "selected_point_fixture",
      "assert": {
        "event": "curve_changed"
      }
    },
    {
      "id": "keyboard-03",
      "dispatch": {
        "key": "Delete",
        "modifiers": []
      },
      "precondition": "Curve editor is focused with a selected non-endpoint.",
      "expected_behavior": "Delete selected point.",
      "initial_state": "selected-point",
      "load_fixture": "selected_point_fixture",
      "assert": {
        "event": "curve_changed"
      }
    },
    {
      "id": "keyboard-04",
      "dispatch": {
        "key": "Tab",
        "modifiers": []
      },
      "precondition": "Curve editor has multiple channels.",
      "expected_behavior": "Select next channel.",
      "initial_state": "multiple-channels",
      "load_fixture": "multiple_channels_fixture",
      "assert": {
        "event": "channel_changed"
      }
    }
  ],
  "accessibility_cases": [
