      "load_fixture": "linear_fixture",
      "expected_semantics": {
        "role": "group",
        "properties": [
          {
            "name": "name",
            "value": "caller-provided label"
          },
          {
            "name": "description",
            "value": "Select a channel, add points by clicking the curve, drag points to edit, delete selected point."
          }
        ]
      },
      "capture": "mkit_harness::AccessibilitySnapshot::capture",
      "requires_active_platform_a11y": true,
