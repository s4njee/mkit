    {
      "id": "a11y-secure",
      "state": "secure",
      "load_fixture": "secure_fixture",
      "expected_semantics": {
        "role": "password",
        "properties": [
          {
            "name": "aria-value",
            "value": "bullet-masked editor text"
          }
        ]
      },
      "capture": "mkit_harness::AccessibilitySnapshot::capture",
      "requires_active_platform_a11y": true,
      "headless_inactive_result": "unsupported_pending"
    }
  ],
