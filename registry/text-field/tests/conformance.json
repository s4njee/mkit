{
  "manifest_version": 1,
  "component": "text-field",
  "source_spec_version": 1,
  "adapter_contract": {
    "fixture": "Provide each declared state fixture; load the initial_state fixture before dispatch.",
    "keyboard": "Dispatch the key with modifiers, then assert every field in the case's assert mapping.",
    "accessibility": "Capture the actual platform accessibility tree and compare declared semantics.",
    "screenshots": "Render each state/theme/scale case and compare its named baseline.",
    "custom_tests": null
  },
  "keyboard_cases": [
    {
      "id": "keyboard-01",
      "dispatch": {
        "key": "Ctrl+A",
        "modifiers": [
          "Ctrl"
        ]
      },
      "precondition": "focused and enabled",
      "expected_behavior": "Select all text using the platform text-editing command.",
      "initial_state": "filled",
      "load_fixture": "filled_fixture",
      "assert": {
        "state": "focused",
        "focus_target": "input"
      }
    },
    {
      "id": "keyboard-02",
      "dispatch": {
        "key": "Ctrl+Z",
        "modifiers": [
          "Ctrl"
        ]
      },
      "precondition": "focused and enabled and not composing",
      "expected_behavior": "Undo the latest edit when the fixture has undo history.",
      "initial_state": "filled",
      "load_fixture": "filled_fixture",
      "assert": {
        "state": "filled",
        "event": "input",
        "focus_target": "input"
      }
    },
    {
      "id": "keyboard-03",
      "dispatch": {
        "key": "Ctrl+Shift+Z",
        "modifiers": [
          "Ctrl",
          "Shift"
        ]
      },
      "precondition": "focused and enabled and not composing",
      "expected_behavior": "Redo the latest undone edit when the fixture has redo history.",
      "initial_state": "filled",
      "load_fixture": "filled_fixture",
      "assert": {
        "state": "filled",
        "event": "input",
        "focus_target": "input"
      }
    },
    {
      "id": "keyboard-04",
      "dispatch": {
        "key": "Ctrl+C",
        "modifiers": [
          "Ctrl"
        ]
      },
      "precondition": "focused and enabled and selection is non-empty",
      "expected_behavior": "Copy the selected text to the system clipboard.",
      "initial_state": "filled",
      "load_fixture": "filled_fixture",
      "assert": {
        "state": "focused",
        "focus_target": "input"
      }
    },
    {
      "id": "keyboard-05",
      "dispatch": {
        "key": "Ctrl+X",
        "modifiers": [
          "Ctrl"
        ]
      },
      "precondition": "focused and enabled and selection is non-empty and not composing",
      "expected_behavior": "Copy selection and delete it as one edit.",
      "initial_state": "filled",
      "load_fixture": "filled_fixture",
      "assert": {
        "state": "filled",
        "event": "input",
        "focus_target": "input"
      }
    },
    {
      "id": "keyboard-06",
      "dispatch": {
        "key": "Ctrl+V",
        "modifiers": [
          "Ctrl"
        ]
      },
      "precondition": "focused and enabled and not composing",
      "expected_behavior": "Replace selection with plain text from the system clipboard.",
      "initial_state": "filled",
      "load_fixture": "filled_fixture",
      "assert": {
        "state": "filled",
        "event": "input",
        "focus_target": "input"
      }
    }
  ],
  "accessibility_cases": [
    {
      "id": "a11y-empty",
      "state": "empty",
      "load_fixture": "empty_fixture",
      "expected_semantics": {
        "role": "textbox",
        "properties": [
          {
            "name": "aria-value",
            "value": "current editor text"
          }
        ]
      },
      "capture": "mkit_harness::AccessibilitySnapshot::capture",
      "requires_active_platform_a11y": true,
      "headless_inactive_result": "unsupported_pending"
    },
    {
      "id": "a11y-filled",
      "state": "filled",
      "load_fixture": "filled_fixture",
