{
  "manifest_version": 1,
  "component": "radio-group",
  "source_spec_version": 1,
  "adapter_contract": {
    "fixture": "Provide each declared state fixture; load the initial_state fixture before dispatch.",
    "keyboard": "Dispatch the key with modifiers, then assert every field in the case's assert mapping.",
    "accessibility": "Capture the actual platform accessibility tree and compare declared semantics.",
    "screenshots": "Render each state/theme/scale case and compare its named baseline.",
    "custom_tests": null
  },
  "keyboard_cases": [
    {
      "id": "keyboard-01",
      "dispatch": {
        "key": "ArrowDown",
        "modifiers": []
      },
      "precondition": "An enabled radio option is focused.",
      "expected_behavior": "Select and focus the next enabled option, wrapping.",
      "initial_state": "first_selected",
      "load_fixture": "first_selected_fixture",
      "assert": {
        "state": "second_selected",
        "event": "ChangeRequested(second)",
        "focus_target": "radio"
      }
    },
    {
      "id": "keyboard-02",
      "dispatch": {
        "key": "Home",
        "modifiers": []
      },
      "precondition": "An enabled radio option is focused.",
      "expected_behavior": "Select and focus the first enabled option.",
      "initial_state": "second_selected",
      "load_fixture": "second_selected_fixture",
      "assert": {
        "state": "first_selected",
        "event": "ChangeRequested(first)",
        "focus_target": "radio"
      }
    },
    {
      "id": "keyboard-03",
      "dispatch": {
        "key": "End",
        "modifiers": []
      },
      "precondition": "An enabled radio option is focused.",
      "expected_behavior": "Select and focus the last enabled option.",
      "initial_state": "first_selected",
      "load_fixture": "first_selected_fixture",
      "assert": {
        "state": "second_selected",
        "event": "ChangeRequested(second)",
        "focus_target": "radio"
      }
    },
    {
      "id": "keyboard-04",
      "dispatch": {
        "key": "ArrowDown",
        "modifiers": []
      },
      "precondition": "The group is disabled.",
      "expected_behavior": "Keep selection and focus unchanged and emit no event.",
      "initial_state": "disabled",
      "load_fixture": "disabled_fixture",
      "assert": {
        "state": "disabled",
        "event": "none",
        "focus_target": "none"
      }
    },
    {
      "id": "keyboard-05",
      "dispatch": {
        "key": "ArrowDown",
        "modifiers": []
      },
      "precondition": "A controlled group has its first option selected.",
      "expected_behavior": "Request the second value and focus it without changing the controlled value.",
      "initial_state": "controlled",
      "load_fixture": "controlled_fixture",
      "assert": {
        "state": "first_selected",
        "event": "ChangeRequested(second)",
        "focus_target": "radio"
      }
    },
    {
      "id": "keyboard-06",
      "dispatch": {
        "key": "ArrowUp",
        "modifiers": []
      },
      "precondition": "The first enabled option is focused in a vertical group.",
      "expected_behavior": "Wrap to the last enabled option, skipping the disabled option.",
      "initial_state": "first_selected",
      "load_fixture": "first_selected_fixture",
      "assert": {
        "state": "second_selected",
        "event": "ChangeRequested(second)",
        "focus_target": "radio"
      }
    },
    {
      "id": "keyboard-07",
      "dispatch": {
        "key": "Space",
        "modifiers": []
      },
      "precondition": "The group has no selection and its first enabled option is focused.",
      "expected_behavior": "Select the focused option.",
      "initial_state": "no_selection",
      "load_fixture": "no_selection_fixture",
      "assert": {
        "state": "first_selected",
        "event": "ChangeRequested(first)",
        "focus_target": "radio"
      }
    },
    {
      "id": "keyboard-08",
      "dispatch": {
        "key": "ArrowRight",
        "modifiers": []
      },
      "precondition": "The first enabled option is focused in a horizontal group.",
      "expected_behavior": "Select and focus the next enabled option, skipping the disabled option.",
      "initial_state": "horizontal_first_selected",
      "load_fixture": "horizontal_first_selected_fixture",
      "assert": {
        "state": "second_selected",
        "event": "ChangeRequested(second)",
        "focus_target": "radio"
      }
    }
  ],
  "accessibility_cases": [
    {
      "id": "a11y-first_selected",
      "state": "first_selected",
      "load_fixture": "first_selected_fixture",
      "expected_semantics": {
        "role": "radiogroup",
        "properties": [
          {
            "name": "aria-orientation",
            "value": "vertical"
          }
        ]
      },
      "capture": "mkit_harness::AccessibilitySnapshot::capture",
      "requires_active_platform_a11y": true,
      "headless_inactive_result": "unsupported_pending"
    },
    {
      "id": "a11y-second_selected",
      "state": "second_selected",
      "load_fixture": "second_selected_fixture",
