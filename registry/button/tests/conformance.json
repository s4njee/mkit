{
  "manifest_version": 1,
  "component": "button",
  "source_spec_version": 1,
  "adapter_contract": {
    "fixture": "Provide each declared state fixture; load the initial_state fixture before dispatch.",
    "keyboard": "Dispatch the key with modifiers, then assert every field in the case's assert mapping.",
    "accessibility": "Capture the actual platform accessibility tree and compare declared semantics.",
    "screenshots": "Render each state/theme/scale case and compare its named baseline.",
    "custom_tests": null
  },
  "keyboard_cases": [
    {
      "id": "keyboard-01",
      "dispatch": {
        "key": "Enter",
        "modifiers": []
      },
      "precondition": "enabled and focused",
      "expected_behavior": "Activate the button.",
      "initial_state": "idle",
      "load_fixture": "button_idle",
      "assert": {
        "event": "activate"
      }
    },
    {
      "id": "keyboard-02",
      "dispatch": {
        "key": "Space",
        "modifiers": []
      },
      "precondition": "enabled and focused",
      "expected_behavior": "Activate the button according to platform button behavior.",
      "initial_state": "idle",
      "load_fixture": "button_idle",
      "assert": {
        "event": "activate"
      }
    }
  ],
  "accessibility_cases": [
    {
      "id": "a11y-idle",
      "state": "idle",
      "load_fixture": "button_idle",
      "expected_semantics": {
        "role": "button",
        "properties": [
          {
            "name": "name",
            "value": "Save"
          }
        ]
      },
      "capture": "mkit_harness::AccessibilitySnapshot::capture",
      "requires_active_platform_a11y": true,
      "headless_inactive_result": "unsupported_pending"
    },
    {
      "id": "a11y-disabled",
      "state": "disabled",
      "load_fixture": "button_disabled",
      "expected_semantics": {
        "role": "button",
        "properties": [
          {
            "name": "name",
            "value": "Save"
          },
          {
            "name": "disabled",
            "value": true
          },
          {
            "name": "description",
            "value": "Unavailable"
          }
        ]
      },
      "capture": "mkit_harness::AccessibilitySnapshot::capture",
      "requires_active_platform_a11y": true,
      "headless_inactive_result": "unsupported_pending"
    },
    {
      "id": "a11y-loading",
      "state": "loading",
      "load_fixture": "button_loading",
      "expected_semantics": {
        "role": "button",
        "properties": [
          {
            "name": "name",
            "value": "Save"
          },
          {
            "name": "disabled",
            "value": true
          },
          {
            "name": "description",
            "value": "Loading"
          }
        ]
      },
      "capture": "mkit_harness::AccessibilitySnapshot::capture",
      "requires_active_platform_a11y": true,
      "headless_inactive_result": "unsupported_pending"
    }
  ],
