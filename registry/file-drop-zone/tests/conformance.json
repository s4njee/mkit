      "load_fixture": "idle_fixture",
      "expected_semantics": {
        "role": "group",
        "properties": [
          {
            "name": "name",
            "value": "caller-provided accessible label"
          },
          {
            "name": "description",
            "value": "accepted file types and browse instruction"
          },
          {
            "name": "live",
            "value": "polite for accepted/rejected feedback"
          }
