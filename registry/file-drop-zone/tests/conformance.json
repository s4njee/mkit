{
  "manifest_version": 1,
  "component": "file-drop-zone",
  "source_spec_version": 1,
  "adapter_contract": {
    "fixture": "Provide each declared state fixture; load the initial_state fixture before dispatch.",
    "keyboard": "Dispatch the key with modifiers, then assert every field in the case's assert mapping.",
    "accessibility": "Capture the actual platform accessibility tree and compare declared semantics.",
    "screenshots": "Render each state/theme/scale case and compare its named baseline.",
    "custom_tests": null
  },
  "keyboard_cases": [
    {
      "id": "keyboard-01",
      "dispatch": {
        "key": "Enter",
        "modifiers": []
      },
      "precondition": "The Browse button is focused and enabled.",
      "expected_behavior": "Open the platform file picker configured by the accept and multiple props.",
      "initial_state": "idle",
      "load_fixture": "idle_fixture",
      "assert": {
        "event": "browse_requested",
        "focus_target": "same_browse_button"
      }
    },
    {
      "id": "keyboard-02",
      "dispatch": {
        "key": "Space",
        "modifiers": []
      },
      "precondition": "The Browse button is focused and enabled.",
      "expected_behavior": "Open the platform file picker configured by the accept and multiple props.",
      "initial_state": "idle",
      "load_fixture": "idle_fixture",
      "assert": {
        "event": "browse_requested",
        "focus_target": "same_browse_button"
      }
    },
    {
      "id": "keyboard-03",
      "dispatch": {
        "key": "Enter",
        "modifiers": []
      },
      "precondition": "A focused enabled Remove file button is selected.",
      "expected_behavior": "Propose removal of that file.",
      "initial_state": "selected",
      "load_fixture": "selected_fixture",
      "assert": {
        "event": "files_change",
        "focus_target": "next_remove_or_browse"
      }
    },
    {
      "id": "keyboard-04",
      "dispatch": {
        "key": "Space",
        "modifiers": []
      },
      "precondition": "A focused enabled Remove file button is selected.",
      "expected_behavior": "Propose removal of that file.",
      "initial_state": "selected",
      "load_fixture": "selected_fixture",
      "assert": {
        "event": "files_change",
        "focus_target": "next_remove_or_browse"
      }
    }
  ],
