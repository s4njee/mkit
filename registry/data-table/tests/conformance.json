{
  "manifest_version": 1,
  "component": "data-table",
  "source_spec_version": 1,
  "adapter_contract": {
    "fixture": "Provide each declared state fixture; load the initial_state fixture before dispatch.",
    "keyboard": "Dispatch the key with modifiers, then assert every field in the case's assert mapping.",
    "accessibility": "Capture the actual platform accessibility tree and compare declared semantics.",
    "screenshots": "Render each state/theme/scale case and compare its named baseline.",
    "custom_tests": null
  },
  "keyboard_cases": [
    {
      "id": "keyboard-01",
      "dispatch": {
        "key": "ArrowDown",
        "modifiers": []
      },
      "precondition": "table is focused",
      "expected_behavior": "Move active cell down one data row, retaining its column and clamping at the last row.",
      "initial_state": "active-cell",
      "load_fixture": "active_cell_fixture",
      "assert": {
        "event": "ActiveCellChanged"
      }
    },
    {
      "id": "keyboard-02",
      "dispatch": {
        "key": "ArrowUp",
        "modifiers": []
      },
      "precondition": "table is focused",
      "expected_behavior": "Move active cell up one data row, retaining its column and clamping at the first row.",
      "initial_state": "active-cell",
      "load_fixture": "active_cell_fixture",
      "assert": {
        "event": "ActiveCellChanged"
      }
    },
    {
      "id": "keyboard-03",
      "dispatch": {
        "key": "ArrowRight",
        "modifiers": []
      },
      "precondition": "table is focused",
      "expected_behavior": "Move right one column in the current row, clamped at the last column.",
      "initial_state": "active-cell",
      "load_fixture": "active_cell_fixture",
      "assert": {
        "event": "ActiveCellChanged"
      }
    },
    {
      "id": "keyboard-04",
      "dispatch": {
        "key": "ArrowLeft",
        "modifiers": []
      },
      "precondition": "table is focused",
      "expected_behavior": "Move left one column in the current row, clamped at the first column.",
      "initial_state": "active-cell",
      "load_fixture": "active_cell_fixture",
      "assert": {
        "event": "ActiveCellChanged"
      }
    },
    {
      "id": "keyboard-05",
      "dispatch": {
        "key": "Home",
        "modifiers": []
      },
      "precondition": "table is focused",
      "expected_behavior": "Move to the first column in the active row.",
      "initial_state": "active-cell",
      "load_fixture": "active_cell_fixture",
      "assert": {
        "event": "ActiveCellChanged"
      }
    },
    {
      "id": "keyboard-06",
      "dispatch": {
        "key": "End",
        "modifiers": []
      },
      "precondition": "table is focused",
      "expected_behavior": "Move to the last column in the active row.",
      "initial_state": "active-cell",
      "load_fixture": "active_cell_fixture",
      "assert": {
        "event": "ActiveCellChanged"
      }
    },
    {
      "id": "keyboard-07",
      "dispatch": {
        "key": "Enter",
        "modifiers": []
      },
      "precondition": "table is focused",
      "expected_behavior": "Sort the active sortable header or toggle selection of the active data row.",
      "initial_state": "active-cell",
      "load_fixture": "active_cell_fixture",
      "assert": {
        "event": "SelectionChanged"
      }
    },
    {
      "id": "keyboard-08",
      "dispatch": {
        "key": "Enter",
        "modifiers": []
      },
      "precondition": "table is focused on an active sortable header",
      "expected_behavior": "Sort that column in ascending order on first activation.",
      "initial_state": "active-header",
      "load_fixture": "active_header_fixture",
      "assert": {
        "event": "SortChanged"
      }
    },
    {
      "id": "keyboard-09",
      "dispatch": {
        "key": "Space",
        "modifiers": []
      },
      "precondition": "table is focused on an active data row",
      "expected_behavior": "Toggle the active data row selection regardless of activation mode.",
      "initial_state": "active-cell",
      "load_fixture": "active_cell_fixture",
      "assert": {
        "event": "SelectionChanged"
      }
    }
  ],
  "accessibility_cases": [
    {
      "id": "a11y-idle",
      "state": "idle",
      "load_fixture": "idle_fixture",
      "expected_semantics": {
        "role": "grid",
        "properties": [
          {
            "name": "accessible-name",
            "value": "component label"
          },
          {
            "name": "aria-rowcount",
            "value": "row count plus header"
          },
          {
            "name": "aria-columncount",
            "value": "column count"
          },
          {
            "name": "rows-and-cells",
            "value": "data rows have row role, a name formed from their cell values, and selection state; each cell has gridcell role and a name combining its column label and cell value"
          }
        ]
      },
      "capture": "mkit_harness::AccessibilitySnapshot::capture",
      "requires_active_platform_a11y": true,
      "headless_inactive_result": "unsupported_pending"
